;;; P29 identity-based class graph, selective invalidation and lazy rack migration.
;;; Standard descriptor extends P27 with: 9 self, 10 direct defaults,
;;; 11 direct superclass objects, 12 CPL objects, 13 cache users,
;;; 14 reserved, 15 generated accessor methods.
(defvar zl-sys::*standard-classes* nil)
(defvar zl-sys::*description-classes* (make-hash-table :test 'eq))
(defvar zl-sys::*description-cpls* (make-hash-table :test 'eq))
(defvar zl-sys::*description-parents* (make-hash-table :test 'eq))
(defvar zl-sys::*legacy-definition-bindings* nil)
(defvar zl-sys::*new-forward-classes* nil)

(defun zl-sys::%standard-description-p (d)
  (and (> (length d) 15) (member (svref d 7) '(:standard :forward))))
(defun zl-sys::%class-cpl-objects (class)
  (let ((d (zl-sys::%class-descriptor class)))
    (if (zl-sys::%standard-description-p d) (svref d 12)
        (or (gethash d zl-sys::*description-cpls*)
            (progn (zl-sys::%remember-legacy-class class) (gethash d zl-sys::*description-cpls*))))))
(defun zl-sys::%class-description (name)
  (let ((d (or (get name 'zl-sys::%class) (get name 'zl-sys::%builtin-class)))
        (c (get name 'zl-sys::%public-class)))
    (if (and d c (or (zl-sys::%standard-description-p d)
                         (not (eq name (class-name c))))) (zl-sys::%class-descriptor c) d)))

;; Keep the P27 lookup for ordinary descriptor registration and record refresh.
(defvar zl-sys::*class-lookup* (fdefinition 'find-class))
(defun zl-sys::%remember-legacy-class (class)
  (let ((d (zl-sys::%class-descriptor class)))
    (unless (zl-sys::%standard-description-p d)
      (setf (gethash d zl-sys::*description-classes*) class)
      (unless (gethash d zl-sys::*description-cpls*)
        (multiple-value-bind (parents frozen) (gethash d zl-sys::*description-parents*)
          (setf (gethash d zl-sys::*description-cpls*)
                (if frozen
                    (let ((all (cons class (mapcan (lambda (c) (copy-list (zl-sys::%class-cpl-objects c))) parents))))
                      (remove-duplicates all :test 'eq))
                    (mapcar (lambda (name) (if (eq name (svref d 0)) class (find-class name))) (svref d 1)))))))))
(defun find-class (name &optional (errorp t) environment)
  (let ((c (funcall zl-sys::*class-lookup* name errorp environment)))
    (when c (zl-sys::%remember-legacy-class c))
    c))
;; Legacy definers still use symbol CPLs internally. During a definition, bind
;; each resolved ancestor name to its descriptor, even if its proper name was
;; unregistered. The public CPL snapshot itself contains class objects.
(defvar zl-sys::*legacy-lookup* (fdefinition 'zl-sys::%find-class))
(defun zl-sys::%find-class (name &optional (errorp t))
  (or (cdr (assoc name zl-sys::*legacy-definition-bindings*))
      (funcall zl-sys::*legacy-lookup* name errorp)))
(defun zl-sys::%define-legacy-class (function args structurep)
  (let* ((name (car args)) (bound (find-class name nil))
         (alias (and bound (not (eq (class-name bound) name))))
         (supernames (if structurep (list (or (cadr args) 'structure-object))
                         (or (cadr args) (unless (member name '(condition restart)) '(condition)))))
         (parents (mapcar #'find-class supernames))
         (zl-sys::*legacy-definition-bindings* nil) (committed nil))
    (dolist (parent parents)
      (dolist (c (zl-sys::%class-cpl-objects parent))
        (unless (eq (class-name c) name)
          (push (cons (class-name c) (zl-sys::%class-descriptor c)) zl-sys::*legacy-definition-bindings*))))
    (dolist (pair (mapcar #'cons supernames parents))
      (unless (eq (car pair) name)
        (push (cons (car pair) (zl-sys::%class-descriptor (cdr pair))) zl-sys::*legacy-definition-bindings*)))
    (when alias (setf (get name 'zl-sys::%class) nil (get name 'zl-sys::%public-class) nil))
    (unwind-protect
        (let ((result (apply function args)))
          ;; Legacy same-kind definitions through an alias redefine the aliased
          ;; class (as SBCL does), preserving its proper name and all aliases.
          (when (and alias
                     (member (if structurep 'structure-object 'condition)
                             (svref (zl-sys::%class-descriptor bound) 1)))
            (let* ((d (get name 'zl-sys::%class)) (proper (class-name bound)))
              (setf (svref d 0) proper (svref d 1) (subst proper name (svref d 1)))
              (zl-sys::%refresh-class bound d (incf zl-sys::*class-stamp*))
              (setf (get name 'zl-sys::%public-class) bound)
              (when (eq (get proper 'zl-sys::%public-class) bound)
                (setf (get proper 'zl-sys::%class) d))))
          (setf (gethash (get name 'zl-sys::%class) zl-sys::*description-parents*) parents)
          (find-class result) (setq committed t) result)
      (when (and alias (not committed))
        (setf (get name 'zl-sys::%class) (zl-sys::%class-descriptor bound)
              (get name 'zl-sys::%public-class) bound)))))
(defvar zl-sys::*define-condition-class* (fdefinition 'zl-sys::%define-condition-class))
(defun zl-sys::%define-condition-class (&rest args)
  (zl-sys::%define-legacy-class zl-sys::*define-condition-class* args nil))
(defvar zl-sys::*define-structure* (fdefinition 'zl-sys::%define-structure))
(defun zl-sys::%define-structure (&rest args)
  (zl-sys::%define-legacy-class zl-sys::*define-structure* args t))
(defun (setf find-class) (class name &optional errorp environment)
  (declare (ignore errorp environment))
  (unless (symbolp name) (error 'type-error :datum name :expected-type 'symbol))
  (unless (or (null class) (zl-sys::%class-p class)) (error 'type-error :datum class :expected-type 'class))
  (when (or (get name 'zl-sys::%builtin-class)
            (and (eq (symbol-package name) (find-package 'common-lisp)) (zl-sys::%class-description name)))
    (error "Cannot replace a standard type name."))
  ;; Materialize the identity before removing a lazily wrapped record class.
  (find-class name nil)
  (if class
      (setf (get name 'zl-sys::%class) (zl-sys::%class-descriptor class)
            (get name 'zl-sys::%public-class) class)
      (setf (get name 'zl-sys::%class) nil (get name 'zl-sys::%public-class) nil))
  class)
(defun zl-sys::%description-class (d)
  (if (zl-sys::%standard-description-p d) (svref d 9)
      (or (gethash d zl-sys::*description-classes*) (find-class (svref d 0)))))
(defun class-of (object)
  (cond ((zl-sys::%instance-p object) (zl-sys::%description-class (zl-sys::%instance-class object)))
        ((zl-sys::%record-p object) (zl-sys::%description-class (zl-sys::%record-class object)))
        ((zl-sys::%structure-p object) (zl-sys::%description-class (zl-sys::%structure-class-of object)))
        (t (find-class (zl-sys::%builtin-class-name object)))))

(defun zl-sys::%legacy-description-typep (object descriptor)
  (if (member (zl-sys::%description-class descriptor) (zl-sys::%class-cpl-objects (class-of object))) t nil))
(defun zl-sys::%condition-reader-type (name) (find-class name))
(defun zl-sys::%report-condition (condition stream)
  (let ((report nil))
    (dolist (class (zl-sys::%class-cpl-objects (class-of condition)))
      (let ((r (svref (zl-sys::%class-descriptor class) 4)))
        (when r (setq report r) (return))))
    (cond ((stringp report) (write-string report stream))
          (report (funcall report condition stream))
          (t (let ((*package* (find-package "COMMON-LISP")))
               (format stream "Condition ~S was signalled." (zl-sys::%condition-type condition)))))))

(defun zl-sys::%register-class-cache (class cache kind)
  (let ((d (zl-sys::%class-descriptor class)))
    (when (and (zl-sys::%standard-description-p d) (not (assoc cache (svref d 13))))
      (push (cons cache kind) (svref d 13)))))
(defun zl-sys::%invalidate-class-caches (class)
  (let* ((d (zl-sys::%class-descriptor class)) (stamp (zl-sys::%class-stamp class)))
    (when (zl-sys::%standard-description-p d)
      (dolist (entry (svref d 13))
        (if (eq (cdr entry) :accessor) (remhash stamp (car entry))
            (let ((remove nil))
              (maphash (lambda (key value) (declare (ignore value))
                         (when (some (lambda (part) (= (car part) stamp)) key) (push key remove))) (car entry))
              (dolist (key remove) (remhash key (car entry)))))))))

;; Bootstrap the one instantiable standard root while retaining its identity.
(let* ((c (find-class 'standard-object)) (old (zl-sys::%class-descriptor c)))
  (unless (zl-sys::%standard-description-p old)
    (let ((d (vector 'standard-object '(standard-object t) '(t) nil nil nil nil :standard
                     (incf zl-sys::*class-stamp*) c nil (list (find-class t)) (list c (find-class t)) nil nil nil)))
      (setf (get 'standard-object 'zl-sys::%builtin-class) d)
      (zl-sys::%refresh-class c d (svref d 8))
      (setf (gethash old zl-sys::*description-classes*) c))))

(defun zl-sys::%forward-class (name &optional fresh)
  (or (and (not fresh) (find-class name nil))
      (let* ((previous (find-class name nil)) (stamp (incf zl-sys::*class-stamp*))
             (d (vector name nil nil nil nil nil nil :forward stamp nil nil nil nil nil nil nil))
             (c (zl-sys::%make-class d 0 stamp)))
        (push (list name c previous) zl-sys::*new-forward-classes*)
        (setf (svref d 9) c (get name 'zl-sys::%class) d (get name 'zl-sys::%public-class) c)
        (push c zl-sys::*standard-classes*) c)))
(defun zl-sys::%planned-description (class plans)
  (or (cdr (assoc class plans)) (zl-sys::%class-descriptor class)))
(defun zl-sys::%direct-superclasses (class plans)
  (let ((d (zl-sys::%planned-description class plans)))
    (if (zl-sys::%standard-description-p d) (svref d 11) (mapcar #'find-class (svref d 2)))))
(defun zl-sys::%p29-cpl (class supers plans)
  (let ((nodes (list class)) (edges nil) (result nil))
    (dolist (s supers)
      (dolist (n (zl-sys::%class-cpl-planned s plans))
        (unless (member n nodes) (setq nodes (append nodes (list n))))))
    (dolist (n nodes)
      (let ((order (cons n (zl-sys::%direct-superclasses n plans))))
        (do ((p order (cdr p))) ((null (cdr p))) (push (cons (car p) (cadr p)) edges))))
    (loop while nodes do
      (let ((candidates nil) (choice nil))
        (dolist (n nodes)
          (unless (find-if (lambda (e) (and (eq (cdr e) n) (member (car e) nodes))) edges)
            (setq candidates (append candidates (list n)))))
        (unless candidates (error "Inconsistent class precedence."))
        (dolist (selected result)
          (unless choice
            (dolist (s (zl-sys::%direct-superclasses selected plans))
              (when (and (null choice) (member s candidates)) (setq choice s)))))
        (unless choice (setq choice (car candidates)))
        (push choice result) (setq nodes (remove choice nodes))))
    (nreverse result)))
(defun zl-sys::%class-cpl-planned (class plans)
  (let ((d (zl-sys::%planned-description class plans)))
    (if (zl-sys::%standard-description-p d) (svref d 12) (zl-sys::%class-cpl-objects class))))
(defun zl-sys::%finalize-description (class plans visiting)
  (when (member class visiting) (error "Cyclic superclass graph."))
  (let ((d (zl-sys::%planned-description class plans)))
    (cond ((not (assoc class plans)) (zl-sys::%class-cpl-objects class))
          ((eq (svref d 7) :forward) nil)
          ((svref d 12) (svref d 12))
          (t
           (let ((ready t))
             (dolist (s (svref d 11))
               (unless (zl-sys::%finalize-description s plans (cons class visiting)) (setq ready nil)))
             (when ready
               (let* ((cpl (zl-sys::%p29-cpl class (svref d 11) plans)) (slots nil)
                      (defaults (copy-list (svref d 10))))
                 (dolist (c cpl)
                   (let ((cd (zl-sys::%planned-description c plans)))
                     (dolist (s (svref cd 6))
                       (let ((old (assoc (car s) slots)))
                         (if old
                             (progn (dolist (a (cadr s)) (pushnew a (cadr old)))
                                    (unless (caddr old) (setf (caddr old) (caddr s))))
                             (setq slots (append slots (list (copy-list s)))))))
                     (when (not (eq c class))
                       (do ((p (if (zl-sys::%standard-description-p cd) (svref cd 10) (svref cd 5)) (cddr p))) ((null p))
                         (unless (zl-sys::%plist-has defaults (car p))
                           (setq defaults (append defaults (list (car p) (cadr p)))))))))
                 (dolist (s slots)
                   (when (eq (fourth s) :class)
                     ;; Copying slot metadata must preserve the shared cell itself.
                     (let* ((owner (find-if (lambda (c) (assoc (car s) (svref (zl-sys::%planned-description c plans) 6))) cpl))
                            (direct (assoc (car s) (svref (zl-sys::%planned-description owner plans) 6))))
                       (unless (fifth direct)
                         (setf (fifth direct) (list (if (caddr s) (funcall (caddr s)) 'zl-sys::%unbound-slot))))
                       (setf (fifth s) (fifth direct)))))
                 (setf (svref d 1) (mapcar #'class-name cpl) (svref d 3) slots (svref d 5) defaults (svref d 12) cpl)
                 cpl)))))))
(defun zl-sys::%affected-classes (class)
  (let ((result (list class)) (changed t))
    (loop while changed do
      (setq changed nil)
      (dolist (c zl-sys::*standard-classes*)
        (when (and (not (member c result))
                   (some (lambda (s) (member s result)) (svref (zl-sys::%class-descriptor c) 11)))
          (push c result) (setq changed t))))
    result))
(defun zl-sys::%publish-class-plans (plans)
  (dolist (entry plans) (zl-sys::%invalidate-class-caches (car entry)))
  (dolist (entry plans)
    (let ((c (car entry)) (d (cdr entry)))
      (setf (svref d 8) (incf zl-sys::*class-stamp*) (svref d 13) nil)
      (zl-sys::%refresh-class c d (svref d 8)))))
(defun zl-sys::%define-standard-class-transaction (name supers direct defaults)
  (when (get name 'zl-sys::%builtin-class) (error "Cannot redefine a built-in class."))
  (let ((old (find-class name nil)))
    (when (and old (eq (class-name old) name) (not (zl-sys::%standard-description-p (zl-sys::%class-descriptor old))))
      (error "Cannot change a class metaclass.")))
  (let* ((bound (find-class name nil))
         (parents (mapcar #'zl-sys::%forward-class (or supers '(standard-object))))
         (class (zl-sys::%forward-class name (and bound (not (eq (class-name bound) name)))))
         (old (zl-sys::%class-descriptor class))
         (d (copy-seq old)) (plans nil))
    (dolist (parent parents)
      (unless (zl-sys::%standard-description-p (zl-sys::%class-descriptor parent)) (error "Unsupported superclass.")))
    (dolist (s direct)
      (let ((previous (assoc (car s) (svref old 6))))
        (when (and previous (eq (fourth s) :class) (eq (fourth previous) :class))
          (setf (fifth s) (fifth previous)))))
    (setf (svref d 0) name (svref d 2) (or supers '(standard-object))
          (svref d 6) direct (svref d 7) :standard (svref d 10) defaults (svref d 11) parents (svref d 15) nil)
    (dolist (c (zl-sys::%affected-classes class))
      (let ((candidate (if (eq c class) d (copy-seq (zl-sys::%class-descriptor c)))))
        (setf (svref candidate 12) nil)
        (push (cons c candidate) plans)))
    (dolist (entry plans) (zl-sys::%finalize-description (car entry) plans nil))
    (zl-sys::%publish-class-plans plans)
    (dolist (m (svref old 15))
      (let ((gf (svref (zl-sys::%method-data m) 3))) (when gf (remove-method gf m))))
    (setf (get name 'zl-sys::%class) d (get name 'zl-sys::%public-class) class)
    class))
(defun zl-sys::%define-standard-class (name supers direct defaults)
  (let ((zl-sys::*new-forward-classes* nil) (committed nil))
    (unwind-protect
        (multiple-value-prog1 (zl-sys::%define-standard-class-transaction name supers direct defaults) (setq committed t))
      (unless committed
        (dolist (entry zl-sys::*new-forward-classes*)
          (let ((n (car entry)) (c (cadr entry)) (previous (caddr entry)))
            (when (and (eq (svref (zl-sys::%class-descriptor c) 7) :forward)
                       (not (some (lambda (dependent)
                                    (member c (svref (zl-sys::%class-descriptor dependent) 11)))
                                  (remove c zl-sys::*standard-classes*))))
              (setf zl-sys::*standard-classes* (remove c zl-sys::*standard-classes*))
              (when (eq (get n 'zl-sys::%public-class) c)
                (setf (get n 'zl-sys::%public-class) previous
                      (get n 'zl-sys::%class) (if previous (zl-sys::%class-descriptor previous) nil))))))))))
(defun zl-sys::%remember-accessor (class method)
  (push method (svref (zl-sys::%class-descriptor class) 15)) method)

(defun zl-sys::%ensure-finalized (class)
  (let ((d (zl-sys::%class-descriptor class)))
    (unless (and (zl-sys::%standard-description-p d) (eq (svref d 7) :standard) (svref d 12))
      (error "Class is not a finalized standard class."))
    d))
(defun zl-sys::%raw-slot-value (object d slot)
  (if (eq (fourth slot) :class) (car (fifth slot))
      (zl-sys::%instance-ref object (zl-sys::%slot-index d (car slot)))))
(defun zl-sys::%migrate-instance (object class)
  (let* ((old (zl-sys::%instance-class object)) (new (zl-sys::%ensure-finalized class))
         (values (make-array (length (svref new 3)) :initial-element 'zl-sys::%unbound-slot))
         (added nil) (discarded nil) (plist nil) (i 0))
    (dolist (s (svref new 3))
      (when (eq (fourth s) :instance)
        (let ((previous (assoc (car s) (svref old 3))))
          (if previous (setf (svref values i) (zl-sys::%raw-slot-value object old previous))
              (push (car s) added))))
      (incf i))
    (dolist (s (svref old 3))
      (when (and (eq (fourth s) :instance)
                 (let ((n (assoc (car s) (svref new 3)))) (or (null n) (eq (fourth n) :class))))
        (push (car s) discarded)
        (let ((v (zl-sys::%raw-slot-value object old s)))
          (unless (eq v 'zl-sys::%unbound-slot) (setq plist (append plist (list (car s) v)))))))
    (zl-sys::%replace-instance object (zl-sys::%make-instance new values))
    (update-instance-for-redefined-class object (nreverse added) (nreverse discarded) plist)
    object))
(defun zl-sys::%ensure-current-instance (object)
  (when (zl-sys::%instance-p object)
    (let ((d (zl-sys::%instance-class object)))
      (when (and (zl-sys::%standard-description-p d)
                 (/= (zl-sys::%instance-stamp object) (zl-sys::%class-stamp (svref d 9))))
        (zl-sys::%migrate-instance object (svref d 9)))))
  object)

(defvar zl-sys::*initialization-validated* nil)
(defun zl-sys::%check-initargs (instance args calls)
  (do ((p args (cddr p))) ((null p))
    (unless (and (consp p) (consp (cdr p)) (symbolp (car p))) (zl-sys::%gf-error "Malformed initialization arguments.")))
  (let ((allowed '(:allow-other-keys)) (any (getf args :allow-other-keys)))
    (dolist (s (svref (zl-sys::%instance-class instance) 3)) (setq allowed (append allowed (cadr s))))
    (dolist (call calls)
      (dolist (m (compute-applicable-methods (car call) (append (cdr call) args)))
        (let ((sig (svref (zl-sys::%method-data m) 4)))
          (setq allowed (append allowed (fifth sig)))
          (when (sixth sig) (setq any t)))))
    (unless any
      (do ((p args (cddr p))) ((null p))
        (unless (member (car p) allowed) (zl-sys::%gf-error "Unknown initialization argument ~S." (car p)))))))
(defun zl-sys::%allocate-standard (class)
  (let ((d (zl-sys::%ensure-finalized class)))
    (zl-sys::%make-instance d (make-array (length (svref d 3)) :initial-element 'zl-sys::%unbound-slot))))

(defgeneric allocate-instance (class &rest initargs &key &allow-other-keys))
(defmethod allocate-instance ((class standard-class) &rest initargs)
  (declare (ignore initargs)) (zl-sys::%allocate-standard class))
(defgeneric shared-initialize (instance slot-names &rest initargs &key &allow-other-keys))
(defmethod shared-initialize ((instance standard-object) slot-names &rest initargs)
  (zl-sys::%ensure-current-instance instance)
  (unless (or (eq slot-names t) (listp slot-names)) (error 'type-error :datum slot-names :expected-type '(or list (eql t))))
  (do ((p initargs (cddr p))) ((null p))
    (unless (and (consp p) (consp (cdr p)) (symbolp (car p))) (zl-sys::%gf-error "Malformed initialization arguments.")))
  (dolist (s (svref (zl-sys::%instance-class instance) 3))
    (let ((v (zl-sys::%initarg-value initargs (cadr s))) (name (car s)))
      (cond ((not (eq v 'zl-sys::%missing)) (setf (slot-value instance name) v))
            ((and (or (eq slot-names t) (member name slot-names))
                  (not (slot-boundp instance name)) (caddr s))
             (setf (slot-value instance name) (funcall (caddr s)))))))
  instance)
(defgeneric initialize-instance (instance &rest initargs &key &allow-other-keys))
(defmethod initialize-instance ((instance standard-object) &rest initargs)
  (unless (eq zl-sys::*initialization-validated* instance)
    (zl-sys::%check-initargs instance initargs (list (list #'initialize-instance instance) (list #'shared-initialize instance t))))
  (apply #'shared-initialize instance t initargs))
(defgeneric make-instance (class &rest initargs &key &allow-other-keys))
(defmethod make-instance ((class symbol) &rest initargs) (apply #'make-instance (find-class class) initargs))
(defmethod make-instance ((class standard-class) &rest initargs)
  (let* ((d (zl-sys::%ensure-finalized class)) (args (copy-list initargs)) (probe (zl-sys::%allocate-standard class)))
    (do ((p args (cddr p))) ((null p))
      (unless (and (consp p) (consp (cdr p)) (symbolp (car p))) (zl-sys::%gf-error "Malformed initialization arguments.")))
    (do ((p (svref d 5) (cddr p))) ((null p))
      (unless (zl-sys::%plist-has args (car p)) (setq args (append args (list (car p) (funcall (cadr p)))))))
    (zl-sys::%check-initargs probe args
      (list (list #'make-instance class) (list #'allocate-instance class)
            (list #'initialize-instance probe) (list #'shared-initialize probe t)))
    (let* ((instance (apply #'allocate-instance class args)) (zl-sys::*initialization-validated* instance))
      (apply #'initialize-instance instance args) instance)))
(defgeneric reinitialize-instance (instance &rest initargs &key &allow-other-keys))
(defmethod reinitialize-instance ((instance standard-object) &rest initargs)
  (zl-sys::%check-initargs instance initargs (list (list #'reinitialize-instance instance) (list #'shared-initialize instance nil)))
  (let ((zl-sys::*initialization-validated* t)) (apply #'shared-initialize instance nil initargs)))
(defgeneric update-instance-for-redefined-class (instance added discarded plist &rest initargs &key &allow-other-keys))
(defmethod update-instance-for-redefined-class ((instance standard-object) added discarded plist &rest initargs)
  (zl-sys::%check-initargs instance initargs
    (list (list #'update-instance-for-redefined-class instance added discarded plist) (list #'shared-initialize instance added)))
  (let ((zl-sys::*initialization-validated* t)) (apply #'shared-initialize instance added initargs)))
(defgeneric make-instances-obsolete (class))
(defmethod make-instances-obsolete ((class symbol)) (make-instances-obsolete (find-class class)))
(defmethod make-instances-obsolete ((class standard-class))
  (zl-sys::%ensure-finalized class)
  (zl-sys::%publish-class-plans
    (mapcar (lambda (c) (cons c (copy-seq (zl-sys::%class-descriptor c)))) (zl-sys::%affected-classes class)))
  class)
(defgeneric update-instance-for-different-class (previous current &rest initargs &key &allow-other-keys))
(defmethod update-instance-for-different-class ((previous standard-object) (current standard-object) &rest initargs)
  (let ((added nil) (old (zl-sys::%instance-class previous)))
    (dolist (s (svref (zl-sys::%instance-class current) 3))
      (when (and (eq (fourth s) :instance) (null (assoc (car s) (svref old 3)))) (push (car s) added)))
    (setq added (nreverse added))
    (zl-sys::%check-initargs current initargs
      (list (list #'update-instance-for-different-class previous current) (list #'shared-initialize current added)))
    (let ((zl-sys::*initialization-validated* t)) (apply #'shared-initialize current added initargs))))
(defgeneric change-class (instance new-class &rest initargs &key &allow-other-keys))
(defmethod change-class (instance (new-class symbol) &rest initargs) (apply #'change-class instance (find-class new-class) initargs))
(defmethod change-class ((instance standard-object) (new-class standard-class) &rest initargs)
  (zl-sys::%ensure-current-instance instance)
  (let* ((old (zl-sys::%instance-class instance)) (new (zl-sys::%ensure-finalized new-class))
         (oldvalues (make-array (length (svref old 3)) :initial-element 'zl-sys::%unbound-slot))
         (values (make-array (length (svref new 3)) :initial-element 'zl-sys::%unbound-slot)) (i 0))
    (dolist (s (svref old 3))
      (when (eq (fourth s) :instance) (setf (svref oldvalues i) (zl-sys::%raw-slot-value instance old s))) (incf i))
    (setq i 0)
    (dolist (s (svref new 3))
      (when (eq (fourth s) :instance)
        (let ((previous (assoc (car s) (svref old 3))))
          (when previous (setf (svref values i) (zl-sys::%raw-slot-value instance old previous))))) (incf i))
    (let ((previous (zl-sys::%make-instance old oldvalues)))
      (zl-sys::%replace-instance instance (zl-sys::%make-instance new values))
      (apply #'update-instance-for-different-class previous instance initargs))
    instance))
