;;; P27 classes and slots. Generic methods and redefinition follow in P28/P29.
;;; Standard descriptor: #(name CPL supers effective-slots nil defaults direct-slots :standard stamp).
;;; Slot: (name initargs initfunction allocation shared-cell).
(defvar zl-sys::*class-stamp* 0)

(defun zl-sys::%class-description (name)
  (or (get name 'zl-sys::%class) (get name 'zl-sys::%builtin-class)))

(defun find-class (name &optional (errorp t) environment)
  (declare (ignore environment))
  (unless (symbolp name) (error 'type-error :datum name :expected-type 'symbol))
  (let ((d (zl-sys::%class-description name)))
    (cond (d (or (let ((cached (get name 'zl-sys::%public-class)))
                   (when cached
                     (unless (eq d (zl-sys::%class-descriptor cached))
                       (zl-sys::%refresh-class cached d (incf zl-sys::*class-stamp*)))
                     cached))
                 (setf (get name 'zl-sys::%public-class)
                       (zl-sys::%make-class d (cond ((or (eq name 'restart) (member 'structure-object (svref d 1))) 2)
                                                   ((member 'condition (svref d 1)) 3)
                                                   ((member name '(standard-object class standard-class built-in-class structure-class zl-sys::condition-class generic-function standard-generic-function method standard-method)) 0)
                                                   ((get name 'zl-sys::%builtin-class) 1)
                                                   (t 0))
                                           (if (and (> (length d) 8) (eq (svref d 7) :standard) (> (svref d 8) 0))
                                               (svref d 8) (incf zl-sys::*class-stamp*))))))
          (errorp (error "No class named ~S." name))
          (t nil))))

(defun class-name (class) (svref (zl-sys::%class-descriptor class) 0))
(defun class-of (object)
  (find-class (cond ((zl-sys::%instance-p object) (svref (zl-sys::%instance-class object) 0))
                    ((zl-sys::%record-p object) (svref (zl-sys::%record-class object) 0))
                    ((zl-sys::%structure-p object) (svref (zl-sys::%structure-class-of object) 0))
                    (t (zl-sys::%builtin-class-name object)))))

;; Built-in descriptors are separate from %class, which TYPEP uses for user types.
(dolist (entry '((t) (standard-object t) (class standard-object t)
                 (standard-class class standard-object t) (built-in-class class standard-object t)
                 (structure-class class standard-object t) (zl-sys::condition-class class standard-object t)
                 (number t) (real number t) (rational real number t) (integer rational real number t)
                 (fixnum integer rational real number t) (bignum integer rational real number t)
                 (ratio rational real number t) (float real number t)
                 (single-float float real number t) (double-float float real number t)
                 (sequence t) (list sequence t) (cons list sequence t)
                 (symbol t) (null symbol list sequence t) (character t)
                 (array t) (vector array sequence t) (string vector array sequence t)
                 (simple-string string vector array sequence t) (simple-vector vector array sequence t)
                 (function t) (generic-function function standard-object t)
                 (standard-generic-function generic-function function standard-object t)
                 (method standard-object t) (standard-method method standard-object t)
                 (hash-table t) (package t) (stream t) (pathname t) (readtable t)))
  (setf (get (car entry) 'zl-sys::%builtin-class)
        (vector (car entry) entry (if (cdr entry) (list (cadr entry)) nil) nil nil nil nil
                (if (eq (car entry) 'standard-object) :standard nil) 0)))

(defun zl-sys::%clos-supers (node name supers)
  (if (eq node name) supers (svref (zl-sys::%class-description node) 2)))

;; CLHS 4.3.5: topological ordering, breaking ties by the rightmost selected
;; class with a direct superclass among the candidates (not C3 linearization).
(defun zl-sys::%clos-cpl (name supers)
  (let ((nodes (list name)) (edges nil) (result nil))
    (dolist (s supers)
      (dolist (n (svref (zl-sys::%class-description s) 1))
        (unless (member n nodes) (setq nodes (append nodes (list n))))))
    (dolist (n nodes)
      (let ((order (cons n (zl-sys::%clos-supers n name supers))))
        (do ((p order (cdr p))) ((null (cdr p))) (push (cons (car p) (cadr p)) edges))))
    (loop while nodes do
      (let ((candidates nil) (choice nil))
        (dolist (n nodes)
          (unless (find-if (lambda (e) (and (eq (cdr e) n) (member (car e) nodes))) edges)
            (setq candidates (append candidates (list n)))))
        (unless candidates (error "Inconsistent class precedence for ~S." name))
        (dolist (selected result)
          (unless choice
            (dolist (s (zl-sys::%clos-supers selected name supers))
              (when (and (not choice) (member s candidates)) (setq choice s)))))
        (unless choice (setq choice (car candidates)))
        (push choice result)
        (setq nodes (remove choice nodes))))
    (nreverse result)))

(defun zl-sys::%clos-effective-slots (cpl name direct)
  (let ((slots nil))
    (dolist (c cpl)
      (dolist (s (if (eq c name) direct (svref (zl-sys::%class-description c) 6)))
        (let ((old (assoc (car s) slots)))
          (if old
              (progn
                (dolist (a (cadr s)) (unless (member a (cadr old)) (push a (cadr old))))
                (unless (caddr old) (setf (caddr old) (caddr s))))
              (setq slots (append slots (list (copy-list s))))))))
    slots))

(defun zl-sys::%define-standard-class (name supers direct defaults)
  (when (zl-sys::%class-description name)
    (error 'zilisp:unimplemented :format-control "Class redefinition (P29)"))
  (unless supers (setq supers '(standard-object)))
  (dolist (s supers)
    (unless (zl-sys::%class-description s)
      (error 'zilisp:unimplemented :format-control "Forward-referenced superclass (P29)"))
    (unless (or (eq s 'standard-object)
                (let ((d (zl-sys::%class-description s)))
                  (and d (> (length d) 7) (eq (svref d 7) :standard))))
      (error "Unsupported superclass ~S." s)))
  (let* ((cpl (zl-sys::%clos-cpl name supers))
         (slots (zl-sys::%clos-effective-slots cpl name direct))
         (effective-defaults (copy-list defaults)))
    (dolist (s slots)
      (when (and (eq (fourth s) :class) (null (fifth s)))
        (setf (fifth s) (list (if (caddr s) (funcall (caddr s)) 'zl-sys::%unbound-slot)))
        ;; Descendants share this cell, including an unbound cell.
        (let ((d (assoc (car s) direct))) (when d (setf (fifth d) (fifth s))))))
    (dolist (c (cdr cpl))
      (do ((p (svref (zl-sys::%class-description c) 5) (cddr p))) ((null p))
        (unless (zl-sys::%plist-has effective-defaults (car p))
          (setq effective-defaults (append effective-defaults (list (car p) (cadr p)))))))
    (setf (get name 'zl-sys::%class)
          (vector name cpl supers slots nil effective-defaults direct :standard (incf zl-sys::*class-stamp*)))
    (find-class name)))

(defmacro defclass (name supers slots &rest options)
  (unless (and (symbolp name) name (not (keywordp name)) (listp supers) (listp slots))
    (zl-sys::%macro-form-error "Invalid DEFCLASS" name))
  (let ((parsed nil) (names nil) (defaults nil) (accessors nil) (checks nil) (result (gensym)))
    (dolist (spec slots)
      (let* ((n (if (symbolp spec) spec (car spec)))
             (keys nil) (init nil) (allocation :instance) (seen nil))
        (unless (and (symbolp n) n (not (keywordp n)) (not (member n names)))
          (zl-sys::%macro-form-error "Invalid or duplicate slot" spec))
        (push n names)
        (do ((p (if (consp spec) (cdr spec) nil) (cddr p))) ((null p))
          (unless (and (consp p) (consp (cdr p))) (zl-sys::%macro-form-error "Invalid slot options" spec))
          (when (and (member (car p) seen) (not (member (car p) '(:initarg :reader :writer :accessor))))
            (zl-sys::%macro-form-error "Duplicate slot option" spec))
          (push (car p) seen)
          (case (car p)
            ((:reader :writer :accessor)
             (let ((a (cadr p)) (o (gensym)) (v (gensym)))
               (unless (or (and (symbolp a) a (not (keywordp a)))
                           (and (eq (car p) :writer) (consp a) (eq (car a) 'setf)
                                (= (length a) 2) (symbolp (cadr a))))
                 (zl-sys::%macro-form-error "Invalid accessor name" a))
               (when (member (car p) '(:reader :accessor))
                 (push (list a 1) checks)
                 (push `(let ((cache (make-hash-table :test 'eql)))
                          (defmethod ,a ((,o ,name)) (zl-sys::%cached-slot-read cache ,o ',n))) accessors))
               (when (member (car p) '(:writer :accessor))
                 (push (list (if (eq (car p) :accessor) `(setf ,a) a) 2) checks)
                 (push `(let ((cache (make-hash-table :test 'eql)))
                          (defmethod ,(if (eq (car p) :accessor) `(setf ,a) a) (,v (,o ,name))
                            (zl-sys::%cached-slot-write cache ,o ',n ,v))) accessors))))
            (:initarg (unless (symbolp (cadr p)) (zl-sys::%macro-form-error "Invalid initarg" spec)) (push (cadr p) keys))
            (:initform (setq init `(function (lambda () ,(cadr p)))))
            (:allocation (unless (member (cadr p) '(:instance :class)) (zl-sys::%macro-form-error "Invalid allocation" spec))
                         (setq allocation (cadr p)))
            ((:documentation :type) nil)
            (otherwise (error 'zilisp:unimplemented :format-control "DEFCLASS slot option (P28)"))))
        (push `(list ',n ',(nreverse keys) ,init ',allocation nil) parsed)))
    (dolist (o options)
      (case (car o)
        (:default-initargs
         (do ((p (cdr o) (cddr p))) ((null p))
           (unless (and (consp p) (consp (cdr p)) (symbolp (car p))) (zl-sys::%macro-form-error "Invalid default initargs" o))
           (push `',(car p) defaults) (push `(function (lambda () ,(cadr p))) defaults)))
        (:documentation nil)
        (otherwise (error 'zilisp:unimplemented :format-control "DEFCLASS option"))))
    `(progn (zl-sys::%check-accessors ',(nreverse checks))
       (let ((,result (zl-sys::%define-standard-class ',name ',supers (list ,@(nreverse parsed)) (list ,@(nreverse defaults)))))
         ,@(mapcar (lambda (form) `(zl-sys::%remember-accessor ,result ,form)) (nreverse accessors)) ,result))))

(defun zl-sys::%clos-slot (object name)
  (zl-sys::%ensure-current-instance object)
  (unless (symbolp name) (error 'type-error :datum name :expected-type 'symbol))
  (unless (zl-sys::%instance-p object)
    (error 'type-error :datum object :expected-type 'standard-object))
  (let* ((d (zl-sys::%instance-class object)) (s (assoc name (svref d 3))))
    (unless s (error "Missing slot ~S." name))
    s))
(defun slot-exists-p (object name)
  (zl-sys::%ensure-current-instance object)
  (unless (symbolp name) (error 'type-error :datum name :expected-type 'symbol))
  (cond ((zl-sys::%instance-p object)
         (if (assoc name (svref (zl-sys::%instance-class object) 3)) t nil))
        ((zl-sys::%structure-p object)
         (if (assoc name (svref (zl-sys::%structure-class-of object) 3)) t nil))
        (t nil)))
(defun zl-sys::%clos-slot-raw (object name)
  (let ((s (zl-sys::%clos-slot object name)))
    (if (eq (fourth s) :class) (car (fifth s))
        (zl-sys::%instance-ref object (zl-sys::%slot-index (zl-sys::%instance-class object) name)))))
(defun slot-value (object name)
  (let ((v (zl-sys::%clos-slot-raw object name)))
    (if (eq v 'zl-sys::%unbound-slot) (error 'unbound-slot :name name :instance object) v)))
(defun (setf slot-value) (value object name)
  (let ((s (zl-sys::%clos-slot object name)))
    (if (eq (fourth s) :class) (setf (car (fifth s)) value)
        (zl-sys::%instance-set object (zl-sys::%slot-index (zl-sys::%instance-class object) name) value))))
(defun slot-boundp (object name) (not (eq (zl-sys::%clos-slot-raw object name) 'zl-sys::%unbound-slot)))
(defun slot-makunbound (object name) (setf (slot-value object name) 'zl-sys::%unbound-slot) object)
