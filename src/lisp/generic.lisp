;;; P28 primary methods. Qualifiers and initialization hooks belong to P29.
;;; GF descriptor: #(name lambda-list signature methods cache self order profile inline-methods).
;;; Method descriptor: #(specializers function lambda-list owner signature).

(defun zl-sys::%gf-error (text &rest args)
  (error 'zl-sys::simple-program-error :format-control text :format-arguments args))

(defun zl-sys::%cached-slot-location (cache object name)
  (let ((stamp (zl-sys::%class-stamp (class-of object))))
    (multiple-value-bind (location foundp) (gethash stamp cache)
      (if foundp location
          (let* ((s (zl-sys::%clos-slot object name))
                 (location (if (eq (fourth s) :class) (fifth s)
                               (zl-sys::%slot-index (zl-sys::%instance-class object) name))))
            (setf (gethash stamp cache) location))))))
(defun zl-sys::%cached-slot-read (cache object name)
  (let* ((location (zl-sys::%cached-slot-location cache object name))
         (value (if (consp location) (car location) (zl-sys::%instance-ref object location))))
    (if (eq value 'zl-sys::%unbound-slot) (error 'unbound-slot :name name :instance object) value)))
(defun zl-sys::%cached-slot-write (cache object name value)
  (let ((location (zl-sys::%cached-slot-location cache object name)))
    (if (consp location) (setf (car location) value) (zl-sys::%instance-set object location value))))

;; Signature: (required-names optional-count rest-p key-p keys allow-other-keys-p).
(defun zl-sys::%gf-signature (ll)
  (let ((required nil) (optional 0) (restp nil) (keyp nil) (keys nil) (allow nil) (state :required) (names nil))
    (dolist (p ll)
      (unless (member p '(&optional &rest &key &allow-other-keys &aux))
        (let ((var (if (consp p) (if (and (eq state :key) (consp (car p))) (cadar p) (car p)) p)))
          (unless (and (symbolp var) var (not (eq var t)) (not (keywordp var)) (not (member var names)))
            (zl-sys::%gf-error "Invalid or duplicate parameter."))
          (push var names)))
      (cond ((eq p '&optional)
             (unless (eq state :required) (zl-sys::%gf-error "Misplaced &OPTIONAL.")) (setq state :optional))
            ((eq p '&rest)
             (unless (member state '(:required :optional)) (zl-sys::%gf-error "Misplaced &REST."))
             (setq state :rest restp t))
            ((eq p '&key)
             (unless (member state '(:required :optional :after-rest)) (zl-sys::%gf-error "Misplaced &KEY."))
             (setq state :key keyp t))
            ((eq p '&allow-other-keys)
             (unless (and keyp (eq state :key) (not allow)) (zl-sys::%gf-error "Misplaced &ALLOW-OTHER-KEYS."))
             (setq allow t))
            ((eq p '&aux) (setq state :aux))
            ((member p '(&body &whole &environment)) (zl-sys::%gf-error "Invalid generic lambda list."))
            ((eq state :required)
             (unless (symbolp p) (zl-sys::%gf-error "Invalid required parameter."))
             (push p required))
            ((eq state :optional) (incf optional))
            ((eq state :rest) (setq state :after-rest))
            ((eq state :key)
             (push (if (and (consp p) (consp (car p))) (caar p)
                       (intern (symbol-name (if (consp p) (car p) p)) "KEYWORD")) keys))
            ((eq state :after-rest) (zl-sys::%gf-error "Unexpected parameter after &REST."))))
    (when (eq state :rest) (zl-sys::%gf-error "Missing &REST parameter."))
    (list (nreverse required) optional restp keyp (nreverse keys) allow)))

(defun zl-sys::%gf-normalize-ll (ll)
  (let ((result nil) (state :required))
    (dolist (p ll (nreverse result))
      (cond ((eq p '&aux) (return (nreverse result)))
            ((eq p '&allow-other-keys) nil)
            ((member p '(&optional &rest &key)) (push p result) (setq state p))
            ((eq state '&key) nil)
            (t (push (if (consp p) (car p) p) result))))))

(defun zl-sys::%gf-method-ll (ll)
  ;; The dispatcher checks the union of applicable keyword parameters. An
  ;; individual method must not reject a key accepted by another method.
  (if (and (member '&key ll) (not (member '&allow-other-keys ll)))
      (let ((result nil))
        (dolist (p ll)
          (when (eq p '&aux) (push '&allow-other-keys result))
          (push p result))
        (unless (member '&aux ll) (push '&allow-other-keys result))
        (nreverse result))
      ll))

(defun zl-sys::%gf-congruent (gf-sig method-sig)
  (unless (and (= (length (car gf-sig)) (length (car method-sig)))
               (= (cadr gf-sig) (cadr method-sig))
               (eq (if (or (third gf-sig) (fourth gf-sig)) t nil)
                   (if (or (third method-sig) (fourth method-sig)) t nil)))
    (zl-sys::%gf-error "Incongruent method lambda list."))
  (when (and (fourth gf-sig) (fourth method-sig) (not (sixth method-sig)))
    (dolist (key (fifth gf-sig))
      (unless (member key (fifth method-sig)) (zl-sys::%gf-error "Method omits a generic keyword.")))))

(defun zl-sys::%check-accessor (name arity)
  (when (fboundp name)
    (let ((gf (fdefinition name)))
      (unless (typep gf 'generic-function) (zl-sys::%gf-error "An ordinary function already has this name."))
      (zl-sys::%gf-congruent (svref (zl-sys::%generic-data gf) 2)
                            (list (make-list arity) 0 nil nil nil nil)))))

(defun zl-sys::%check-accessors (specs)
  (let ((seen nil))
    (dolist (spec specs)
      (let ((previous (assoc (car spec) seen :test 'equal)))
        (when (and previous (/= (cadr previous) (cadr spec)))
          (zl-sys::%gf-error "Inconsistent accessor arities.")))
      (push spec seen)
      (zl-sys::%check-accessor (car spec) (cadr spec)))))

(defun zl-sys::%gf-order (sig names)
  (let ((required (car sig)))
    (if names
        (progn
          (unless (and (= (length names) (length required))
                       (= (length (remove-duplicates names)) (length names))
                       (every (lambda (n) (member n required)) names))
            (zl-sys::%gf-error "Invalid argument precedence order."))
          (mapcar (lambda (n) (position n required)) names))
        (loop for i from 0 below (length required) collect i))))

(defun zl-sys::%ensure-generic (name ll order)
  (let* ((sig (zl-sys::%gf-signature ll))
         (argorder (zl-sys::%gf-order sig order))
         (old (if (fboundp name) (fdefinition name) nil)))
    (if old
        (progn
          (unless (typep old 'generic-function) (zl-sys::%gf-error "An ordinary function already has this name."))
          (let ((d (zl-sys::%generic-data old)))
            (dolist (m (svref d 3))
              (unless (member m (svref d 8)) (zl-sys::%gf-congruent sig (svref (zl-sys::%method-data m) 4))))
            (dolist (m (svref d 8)) (remove-method old m))
            (setf (svref d 8) nil)
            (setf (svref d 1) ll (svref d 2) sig (svref d 6) argorder)
            (clrhash (svref d 4)))
          old)
        (let* ((d (vector name ll sig nil (make-hash-table :test 'equal) nil argorder nil nil))
               (gf (zl-sys::%make-generic name d (lambda (&rest args) (zl-sys::%gf-dispatch d args)))))
          (setf (svref d 5) gf (fdefinition name) gf)
          gf))))

(defmacro defgeneric (name ll &rest options)
  (zl-sys::%gf-signature ll)
  (let ((state :required))
    (dolist (p ll)
      (cond ((eq p '&aux) (zl-sys::%macro-form-error "&AUX is not allowed in DEFGENERIC" ll))
            ((member p '(&optional &rest &key &allow-other-keys)) (setq state p))
            ((and (consp p) (not (and (member state '(&optional &key)) (= (length p) 1)
                                     (or (symbolp (car p))
                                         (and (eq state '&key) (consp (car p)) (= (length (car p)) 2))))))
             (zl-sys::%macro-form-error "Defaults are not allowed in DEFGENERIC" p)))))
  (let ((order nil) (methods nil) (seen nil))
    (dolist (o options)
      (when (and (member (car o) seen) (not (member (car o) '(:method declare))))
        (zl-sys::%macro-form-error "Duplicate DEFGENERIC option" o))
      (push (car o) seen)
      (case (car o)
        (:argument-precedence-order (setq order (cdr o)))
        (:method (push `(defmethod ,name ,@(cdr o)) methods))
        ((:documentation declare) nil)
        (:method-combination (unless (equal (cdr o) '(standard))
                               (error 'zilisp:unimplemented :format-control "Method combination")))
        (:generic-function-class (unless (equal (cdr o) '(standard-generic-function))
                                   (error 'zilisp:unimplemented :format-control "Generic function metaclass")))
        (:method-class (unless (equal (cdr o) '(standard-method))
                         (error 'zilisp:unimplemented :format-control "Method metaclass")))
        (otherwise (zl-sys::%macro-form-error "Unknown DEFGENERIC option" o))))
    (let ((gf (gensym)))
      `(let ((,gf (zl-sys::%ensure-generic ',name ',ll ',order)))
         ,@(mapcar (lambda (form) `(push ,form (svref (zl-sys::%generic-data ,gf) 8))) (nreverse methods))
         ,gf))))

(defun zl-sys::%gf-same-specializers (a b)
  (and (= (length a) (length b))
       (every (lambda (x y) (if (and (consp x) (consp y))
                               (and (eq (car x) 'eql) (eq (car y) 'eql) (eql (cadr x) (cadr y)))
                               (eq x y))) a b)))

(defun zl-sys::%gf-profile (d)
  (let ((profile nil) (n (length (car (svref d 2)))))
    (dotimes (i n)
      (let ((active nil) (eqls nil))
        (dolist (m (svref d 3))
          (let ((s (nth i (svref (zl-sys::%method-data m) 0))))
            (if (consp s) (progn (setq active t) (push (cadr s) eqls))
                (unless (eq (class-name s) t) (setq active t)))))
        (when active (push (cons i eqls) profile))))
    (setf (svref d 7) (nreverse profile))
    (clrhash (svref d 4))))

(defun add-method (gf method)
  (let* ((d (zl-sys::%generic-data gf)) (m (zl-sys::%method-data method)))
    (when (and (svref m 3) (not (eq (svref m 3) gf))) (zl-sys::%gf-error "Method belongs to another generic function."))
    (zl-sys::%gf-congruent (svref d 2) (svref m 4))
    (let ((old (find-if (lambda (other) (zl-sys::%gf-same-specializers (svref m 0) (svref (zl-sys::%method-data other) 0))) (svref d 3))))
      (when old
        (setf (svref (zl-sys::%method-data old) 3) nil)
        (setf (svref d 3) (remove old (svref d 3)))))
    (push method (svref d 3))
    (setf (svref m 3) gf)
    (zl-sys::%gf-profile d)
    gf))

(defun remove-method (gf method)
  (let* ((d (zl-sys::%generic-data gf)) (m (zl-sys::%method-data method)))
    (when (member method (svref d 3))
      (setf (svref d 3) (remove method (svref d 3)) (svref m 3) nil)
      (zl-sys::%gf-profile d))
    gf))

(defun find-method (gf qualifiers specializers &optional (errorp t))
  (let* ((d (zl-sys::%generic-data gf))
         (m (unless qualifiers
              (find-if (lambda (method) (zl-sys::%gf-same-specializers specializers (svref (zl-sys::%method-data method) 0))) (svref d 3)))))
    (cond (m m) (errorp (error "No matching method.")) (t nil))))

(defun method-qualifiers (method) (zl-sys::%method-data method) nil)

(defun zl-sys::%gf-count (d args)
  (let* ((sig (svref d 2)) (n (length args)) (required (length (car sig))))
    (unless (and (>= n required) (or (third sig) (fourth sig) (<= n (+ required (cadr sig)))))
      (zl-sys::%gf-error "Wrong argument count for ~S." (svref d 0)))))

(defun zl-sys::%gf-applicable (method args)
  (every (lambda (s arg) (if (consp s) (eql (cadr s) arg) (typep arg s)))
         (svref (zl-sys::%method-data method) 0) args))

(defun zl-sys::%gf-rank (s arg)
  (if (consp s) -1
      (let* ((name (class-name s)) (cpl (svref (zl-sys::%class-descriptor (class-of arg)) 1)))
        (if (eq name t) (1+ (length cpl)) (or (position name cpl) (length cpl))))))

(defun zl-sys::%gf-more-specific (a b args order)
  (let ((sa (svref (zl-sys::%method-data a) 0)) (sb (svref (zl-sys::%method-data b) 0)))
    (dolist (i order nil)
      (let ((ra (zl-sys::%gf-rank (nth i sa) (nth i args)))
            (rb (zl-sys::%gf-rank (nth i sb) (nth i args))))
        (cond ((< ra rb) (return t)) ((> ra rb) (return nil)))))))

(defun compute-applicable-methods (gf args)
  (let ((d (zl-sys::%generic-data gf)))
    (zl-sys::%gf-count d args)
    (stable-sort (remove-if-not (lambda (m) (zl-sys::%gf-applicable m args)) (copy-list (svref d 3)))
                 (lambda (a b) (zl-sys::%gf-more-specific a b args (svref d 6))))))

(defun zl-sys::%gf-keywords (d methods args)
  (let* ((sig (svref d 2)) (skip (+ (length (car sig)) (cadr sig))))
    (when (and (or (fourth sig)
                   (some (lambda (m) (fourth (svref (zl-sys::%method-data m) 4))) methods))
               (> (length args) skip))
      (let ((tail (nthcdr skip args)) (allowed (copy-list (fifth sig))) (any (sixth sig)))
        (unless (evenp (length tail)) (zl-sys::%gf-error "Odd keyword argument count."))
        (dolist (m methods)
          (let ((ms (svref (zl-sys::%method-data m) 4)))
            (setq allowed (append allowed (fifth ms)))
            (when (sixth ms) (setq any t))))
        (unless (or any (getf tail :allow-other-keys))
          (do ((p tail (cddr p))) ((null p))
            (unless (or (eq (car p) :allow-other-keys) (member (car p) allowed))
              (zl-sys::%gf-error "Unknown generic keyword ~S." (car p)))))))))

(defun zl-sys::%gf-invoke (gf methods args all)
  (if methods
      (let* ((m (car methods)) (data (zl-sys::%method-data m)))
        (apply (svref data 1) (append (list (cdr methods) args all gf m) args)))
      (apply #'no-applicable-method gf args)))

(defun zl-sys::%gf-next (gf current next original all newargs)
  (let ((args (if newargs newargs original)))
    (when (and newargs (not (equal all (compute-applicable-methods gf args))))
      (zl-sys::%gf-error "CALL-NEXT-METHOD changes applicable methods."))
    (when newargs (zl-sys::%gf-keywords (zl-sys::%generic-data gf) all args))
    (if next (zl-sys::%gf-invoke gf next args all) (apply #'no-next-method gf current args))))

(defun zl-sys::%gf-dispatch (d args)
  (zl-sys::%gf-count d args)
  (let ((key (mapcar (lambda (p)
                       (let ((arg (nth (car p) args)))
                         (cons (zl-sys::%class-stamp (class-of arg))
                               (mapcar (lambda (value) (if (eql value arg) t nil)) (cdr p)))))
                     (svref d 7))))
    (multiple-value-bind (methods foundp) (gethash key (svref d 4))
      (unless foundp
        (setq methods (compute-applicable-methods (svref d 5) args))
        (setf (gethash key (svref d 4)) methods))
      (zl-sys::%gf-keywords d methods args)
      (zl-sys::%gf-invoke (svref d 5) methods args methods))))

(defun zl-sys::%install-method (name ll specializers function)
  (let* ((gf (if (fboundp name) (fdefinition name) (zl-sys::%ensure-generic name (zl-sys::%gf-normalize-ll ll) nil)))
         (method (zl-sys::%make-method (vector specializers function ll nil (zl-sys::%gf-signature ll)))))
    (unless (typep gf 'generic-function) (zl-sys::%gf-error "An ordinary function already has this name."))
    (add-method gf method)
    method))

(defmacro defmethod (name &rest definition)
  (unless (and definition (listp (car definition)))
    (error 'zilisp:unimplemented :format-control "Method qualifiers (P29)"))
  (let ((plain nil) (specializers nil) (state :required) (body (cdr definition))
        (next (gensym)) (args (gensym)) (all (gensym)) (gf (gensym)) (self (gensym)) (decls nil))
    (dolist (p (car definition))
      (if (member p '(&optional &rest &key &aux &allow-other-keys))
          (progn (setq state :tail) (push p plain))
          (if (eq state :required)
              (let ((var (if (consp p) (car p) p)) (s (if (consp p) (cadr p) t)))
                (unless (and (symbolp var) (or (symbolp p) (= (length p) 2)))
                  (zl-sys::%macro-form-error "Invalid method parameter" p))
                (push var plain)
                (push (if (and (consp s) (eq (car s) 'eql) (= (length s) 2)) `(list 'eql ,(cadr s))
                          (if (symbolp s) `(find-class ',s)
                              (zl-sys::%macro-form-error "Invalid specializer" s))) specializers))
              (push p plain))))
    (setq plain (nreverse plain) specializers (nreverse specializers))
    (when (and (cdr body) (stringp (car body))) (setq body (cdr body)))
    (loop while (and (consp (car body)) (eq (caar body) 'declare)) do (push (pop body) decls))
    `(zl-sys::%install-method ',name ',plain (list ,@specializers)
       (function (lambda (,next ,args ,all ,gf ,self ,@(zl-sys::%gf-method-ll plain))
                   ,@(nreverse decls)
                   (flet ((call-next-method (&rest newargs) (zl-sys::%gf-next ,gf ,self ,next ,args ,all newargs))
                          (next-method-p () (if ,next t nil)))
                     (block ,(if (consp name) (cadr name) name) ,@body)))))))

(defgeneric no-applicable-method (generic-function &rest args))
(defmethod no-applicable-method (generic-function &rest args)
  (declare (ignore args)) (error "No applicable method for ~S." generic-function))
(defgeneric no-next-method (generic-function method &rest args))
(defmethod no-next-method (generic-function method &rest args)
  (declare (ignore method args)) (error "No next method for ~S." generic-function))

(defvar zl-sys::*legacy-print-record* (fdefinition 'zl-sys::%print-record))
(defgeneric print-object (object stream))
(defmethod print-object (object stream)
  (cond ((or (zl-sys::%record-p object) (zl-sys::%structure-p object))
         (funcall zl-sys::*legacy-print-record* object stream))
        ((zl-sys::%instance-p object)
        (when *print-readably* (error 'print-not-readable :object object))
        (format stream "#<~S {~X}>" (class-name (class-of object)) (zl-sys::%object-address object)))
        ((typep object 'standard-object) (zl-sys::%builtin-print-object object stream))
        (t (write object :stream stream)))
  object)
(defun zl-sys::%print-record (object stream) (print-object object stream))

(defun zl-sys::%register-structure-printer-method (name)
  ;; DEFSTRUCT printers are class-specific PRINT-OBJECT methods, so they
  ;; take precedence over methods specialized on STRUCTURE-OBJECT.
  (zl-sys::%install-method 'print-object '(object stream) (list (find-class name) (find-class t))
    (lambda (next args all gf self object stream)
      (declare (ignore next args all gf self))
      (zl-sys::%print-structure object stream))))

(defmacro print-unreadable-object (spec &body body)
  (destructuring-bind (object stream &key type identity) spec
    (let ((o (gensym)) (s (gensym)) (ty (gensym)) (id (gensym)))
      `(let ((,o ,object) (,s ,stream) (,ty ,type) (,id ,identity))
         (when *print-readably* (error 'print-not-readable :object ,o))
         (write-string "#<" ,s)
         (when ,ty (prin1 (class-name (class-of ,o)) ,s))
         ,@(when body `((when ,ty (write-char #\Space ,s)) ,@body))
         (when ,id
           (when ,(if body t ty) (write-char #\Space ,s))
           (format ,s "{~X}" (zl-sys::%object-address ,o)))
         (write-char #\> ,s)
         nil))))
