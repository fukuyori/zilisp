;; P29 review: aliases, failed definitions and legacy-class identity.
(defclass lr-a () ((x :initform 1)))
(defparameter *lr-instance* (make-instance 'lr-a))
(setf (find-class 'lr-b) (find-class 'lr-a))
(defclass lr-b () ((y :initform 2)))
(print (list (eq (find-class 'lr-a) (find-class 'lr-b)) (class-name (find-class 'lr-a))
             (slot-exists-p *lr-instance* 'x)))
(print (handler-case (eval '(defclass lr-oops (integer) ())) (error () :invalid)))
(print (find-class 'lr-oops nil))
(define-condition lr-oops (error) ())
(print (typep (make-condition 'lr-oops) 'error))
(print (handler-case (eval '(defclass lr-cycle (lr-uncreated-parent lr-cycle) ())) (error () :cycle)))
(print (find-class 'lr-cycle nil))
(defclass lr-bound () ())
(setf (find-class 'lr-retry) (find-class 'lr-bound))
(print (handler-case (eval '(defclass lr-retry (integer) ())) (error () :invalid)))
(print (eq (find-class 'lr-retry) (find-class 'lr-bound)))
;; Mutually swapped structure names must neither recurse nor change identities.
(defstruct lr-sx)
(defstruct lr-sy)
(defparameter *lr-sx* (make-lr-sx))
(let ((cx (find-class 'lr-sx)) (cy (find-class 'lr-sy)))
  (setf (find-class 'lr-sx) cy (find-class 'lr-sy) cx))
(print (list (typep 1 'lr-sx) (typep *lr-sx* 'lr-sx) (typep *lr-sx* 'lr-sy)))
(define-condition lr-parent (error) ())
(define-condition lr-child (lr-parent) ())
(defparameter *lr-condition* (make-condition 'lr-child))
(defparameter *lr-parent-class* (find-class 'lr-parent))
(defmethod lr-dispatch ((x condition)) :base)
(defmethod lr-dispatch ((x lr-parent)) :parent)
(setf (find-class 'lr-parent-alias) *lr-parent-class*)
(setf (find-class 'lr-parent) nil)
(print (list (lr-dispatch *lr-condition*) (typep *lr-condition* 'lr-parent-alias)))
(define-condition lr-parent (error) ())
(print (list (typep *lr-condition* *lr-parent-class*) (typep *lr-condition* (find-class 'lr-parent))))
;; Looking up an alias must not restore the old descriptor after redefinition.
(define-condition lr-refreshed (error) ())
(setf (find-class 'lr-refreshed-alias) (find-class 'lr-refreshed))
(define-condition lr-refreshed (warning) ())
(find-class 'lr-refreshed-alias)
(let ((v (make-condition 'lr-refreshed)))
  (print (list (eq (class-of v) (find-class 'lr-refreshed-alias)) (typep v 'warning) (typep v 'error))))
;; Around-only standard combinations must signal, and auxiliary next calls fail.
(defmethod lr-no-primary :around ((x integer)) :no-next)
(print (handler-case (lr-no-primary 1) (error () :no-primary)))
(defmethod lr-before-next ((x integer)) :primary)
(defmethod lr-before-next :before ((x integer)) (call-next-method))
(print (handler-case (lr-before-next 1) (error () :auxiliary-next)))
;; Legacy same-kind definitions update the aliased class and preserve its proper name.
(define-condition lr-alias-source (warning) ())
(setf (find-class 'lr-alias-condition) (find-class 'lr-alias-source))
(define-condition lr-alias-condition (error) ())
(print (list (eq (find-class 'lr-alias-source) (find-class 'lr-alias-condition))
             (class-name (find-class 'lr-alias-condition))
             (typep (make-condition 'lr-alias-source) 'lr-alias-condition)
             (typep (make-condition 'lr-alias-condition) 'error)))
(defstruct lr-struct-source)
(setf (find-class 'lr-alias-struct) (find-class 'lr-struct-source))
(defstruct lr-alias-struct)
(print (list (eq (find-class 'lr-struct-source) (find-class 'lr-alias-struct))
             (class-name (class-of (make-lr-alias-struct)))))
;; A parent alias preserves inherited readers and reports.
(define-condition lr-parent-slots (error) ((x :initarg :x :reader lr-parent-x))
  (:report (lambda (x s) (format s "value=~D" (lr-parent-x x)))))
(setf (find-class 'lr-parent-slots-alias) (find-class 'lr-parent-slots))
(define-condition lr-via-alias (lr-parent-slots-alias) ())
(let ((x (make-condition 'lr-via-alias :x 23)))
  (print (list (typep x 'lr-parent-slots-alias) (lr-parent-x x) (princ-to-string x))))
;; Keep a failed definition's placeholder if a completed nested definition uses it.
(print (handler-case
         (eval '(defclass lr-outer ()
                  ((s :allocation :class :initform
                       (progn (eval '(defclass lr-inner (lr-outer) ())) (error "outer failed"))))))
         (error () :outer-failed)))
(defclass lr-outer () ((x :initform 31)))
(print (slot-value (make-instance 'lr-inner) 'x))
