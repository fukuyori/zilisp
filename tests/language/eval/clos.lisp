;; P27 acceptance; compare new cases with SBCL 2.6.10.168.
(defclass p27-point () ((x :initarg :x :initform 0) (y :initarg :y)))
(let ((p (make-instance 'p27-point :x 42)))
  (print (list (class-name (class-of p)) (slot-value p 'x)
               (typep p 'p27-point) (typep p 'standard-object)
               (eq (class-of p) (find-class 'p27-point))
               (slot-boundp p 'y) (slot-exists-p p 'y) (slot-exists-p p 'z)))
  (setf (slot-value p 'y) 9)
  (print (list (slot-value p 'y) (eq (slot-makunbound p 'y) p) (slot-boundp p 'y)))
  (print (handler-case (slot-value p 'y) (unbound-slot (c) (list (cell-error-name c) (eq (unbound-slot-instance c) p))))))
(defclass p27-base () ((shared :allocation :class :initform 7) (v :initarg :v :initform :base)))
(defclass p27-left (p27-base) ())
(defclass p27-right (p27-base) ())
(defclass p27-diamond (p27-left p27-right) ((v :initform :derived)) (:default-initargs :v :default))
(let ((a (make-instance 'p27-diamond)) (b (make-instance 'p27-right)))
  (print (list (slot-value a 'v) (slot-value a 'shared) (typep a 'p27-base) (typep a 'p27-left)))
  (setf (slot-value a 'shared) 12)
  (print (slot-value b 'shared)))
(let ((n 40))
  (defclass p27-lexical () ((x :initform (incf n))))
  (print (list (slot-value (make-instance 'p27-lexical) 'x) (slot-value (make-instance 'p27-lexical) 'x))))
(print (list (class-name (class-of 5)) (class-name (class-of nil))
             (typep (find-class 'p27-point) 'class) (typep (find-class 'p27-point) 'standard-class)
             (typep (make-instance 'p27-point) (find-class 'p27-point))
             (find-class 'p27-missing nil)))
(print (handler-case (make-instance 'p27-point :unknown 1) (error () :error)))
(print (slot-value (make-instance 'p27-point :unknown 1 :allow-other-keys t) 'x))
(defstruct p27-structure x)
(define-condition p27-condition (error) ((x :initarg :x)))
(print (list (class-name (class-of (make-p27-structure)))
             (eq (class-of (make-p27-structure)) (find-class 'p27-structure))
             (class-name (class-of (make-condition 'p27-condition)))
             (slot-value (make-condition 'p27-condition :x 8) 'x)))
(defclass p27-a () ())
(defclass p27-b () ())
(defclass p27-ab (p27-a p27-b) ())
(defclass p27-ba (p27-b p27-a) ())
(print (handler-case (eval '(defclass p27-impossible (p27-ab p27-ba) ())) (error () :error)))
(print (list (typep (make-condition 'error) 'standard-object)
             (typep (find-class 'condition) 'standard-class)
             (typep (find-class 'condition) 'class)
             (typep (find-class 'condition) (class-of (find-class 'condition)))))
(print (handler-case (slot-exists-p (make-instance 'p27-point) 3)
         (type-error (c) (list (type-error-datum c) (type-error-expected-type c)))))
(defclass p27-gc () (a b c d (e :initarg :e)))
(let ((p (make-instance 'p27-gc :e (list (copy-seq "payload") (vector 1 2) (list 3)))))
  (dotimes (i 100) (make-array 32 :initial-element i))
  (print (equalp (slot-value p 'e) '("payload" #(1 2) (3)))))
(print (list (typep (make-instance 'standard-object) 'standard-object)
             (typep (make-instance 'p27-a) 'p27-a)
             (slot-exists-p (make-instance 'p27-a) 'missing)))
