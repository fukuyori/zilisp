;; Phase 26：defstruct の #S の読み取りと、#n=・#n# で自分を指す構造体（CLHS 2.4.8.13・2.4.8.15。詳細設計 §10.5）。
;; 期待値は SBCL 2.6.7 と同じ出力。defstruct.lisp から分けた（GC stress とネイティブの実行に時間がかかるため）

(defmacro try (form)
  `(handler-case (print (multiple-value-list ,form))
     (type-error (c) (format t "~%TYPE-ERROR ~S ~S" (type-error-datum c) (type-error-expected-type c)))
     (error () (format t "~%ERR"))))
;; 読み取りの例が使う構造体
(defstruct point (x 0) (y 0))
(defstruct node (next nil :type (or null node)) (val 0 :type (integer 0 10)))
(defstruct animal (name "?") (legs 4))
(defstruct (dog (:include animal)) (breed "mix"))
(defvar *d* (make-dog :name "Pochi"))
(defstruct (opt1 (:conc-name o1-) (:constructor new-opt1) (:copier clone-opt1) (:predicate is-opt1)) a b)
(defstruct (opt5 (:constructor nil) (:copier nil) (:predicate nil)) a)
(defstruct (opt7 (:constructor make-opt7) (:constructor opt7-pos (c b a))) (a 10) (b 20) (c 30) (d 40) e f g h i (j 99))
;; #S
(try (read-from-string "#S(point :x 1 :y 2)"))
(try (read-from-string "#S(point)"))
(try (read-from-string "#s(POINT y 5)"))
(try (read-from-string "#S(point :x (1 2) :y #S(point :x a))"))
(try (point-x (read-from-string "#S(point :x (1 2) :y #S(point :x a))")))
(try (read-from-string "#S(nosuch :x 1)"))
(try (read-from-string "#S(point :z 1)"))
(try (read-from-string "#S(opt5 :a 1)"))
(try (read-from-string "#S(opt1 :a 1)"))
(try (read-from-string "#S(opt7 :a 1)"))
(try (read-from-string "#S(dog :name \"x\" :breed \"y\")"))
(try (read-from-string "#S(5)"))
(try (read-from-string "#S point"))
(try (read-from-string "#S()"))
(try (read-from-string "#S(point :x)"))
(try (read-from-string "(#+nosuch #S(nosuch :a 1) ok)"))
(try (equalp (read-from-string (prin1-to-string *d*)) *d*))
(try (let ((*print-readably* t)) (equalp (read-from-string (prin1-to-string (make-point :x "s" :y #\c))) (make-point :x "s" :y #\c))))
;; circle
(try (let ((*print-circle* t) (p (make-point))) (setf (point-x p) p) (prin1-to-string p)))
(try (let ((*print-circle* t) (p (make-point)) (*print-pretty* nil)) (setf (point-x p) p) (prin1-to-string p)))
(try (let ((*print-circle* t) (l (list 1 2))) (prin1-to-string (make-point :x l :y l))))
(try (let ((*print-circle* t) (p (make-point))) (prin1-to-string (list p p))))
;; Codex のレビュー P26 1回目
;; #1：#n= と #n# で自分を指す構造体。型のあるスロットは、置き換えた後で確かめる
(defmacro te (form) `(handler-case ,form (type-error () :type-error)))
(try (let ((v (read-from-string "#1=#S(node :next #1#)"))) (list (eq v (node-next v)) (let ((*print-circle* t)) (prin1-to-string v)))))
(try (let ((v (read-from-string "(#1=(a) #S(point :x #1#))"))) (eq (car v) (point-x (cadr v)))))
(try (let ((v (read-from-string "#1=(a #S(point :x #1#))"))) (eq v (point-x (cadr v)))))
(try (let ((v (read-from-string "#1=#(a #S(point :x #1# :y (#1#)))"))) (list (eq v (point-x (aref v 1))) (eq v (car (point-y (aref v 1)))))))
(try (let ((v (read-from-string "#S(point :x #1=(x . #1#))"))) (eq (point-x v) (cdr (point-x v)))))
(try (te (let ((v (read-from-string "#1=#S(node :val #1#)"))) (eq v (node-val v)))))
(try (te (let ((v (read-from-string "#1=(q #S(node :val #1#))"))) (eq v (node-val (cadr v))))))
(try (te (let ((v (read-from-string "(#1=(q) #S(node :val #1#))"))) (node-val (cadr v)))))
(try (te (let ((v (read-from-string "#1=(q #S(node :val 5 :next nil) #1#)"))) (node-val (cadr v)))))
;; 2回目 #1：スロットの値のリスト・ベクタの中の #n# も、置き換えた後の値で型を確かめる
(defstruct n1 (next nil :type (cons n1 null)))
(defstruct n2 (next nil :type (cons cons null)))
(defstruct n4 (next nil :type (or null (vector t 1))))
(try (te (let ((v (read-from-string "#1=#S(n1 :next (#1#))"))) (eq v (car (n1-next v))))))
(try (te (let ((v (read-from-string "#1=#S(n2 :next (#1#))"))) (list :accepted (typep (n2-next v) '(cons cons null))))))
(try (te (let ((v (read-from-string "#1=(a #S(n2 :next (#1#)))"))) (eq v (car (n2-next (cadr v)))))))
(try (te (progn (read-from-string "#1=(a #S(n1 :next (#1#)))") :accepted)))
(try (te (let ((v (read-from-string "#1=#S(n4 :next #(#1#))"))) (eq v (aref (n4-next v) 0)))))
;; 3回目 #1：循環する #S を読んでいる間も、initform が作る別の構造体・setf・入れ子の読み取りの型は検査する
(defstruct inner (n 1 :type integer))
(defun bad-value () "bad")
(defstruct outer x (y (make-inner :n (bad-value))))
(try (te (let ((v (read-from-string "#1=#S(outer :x #1#)"))) (list :accepted (inner-n (outer-y v))))))
(defvar *in* (make-inner))
(defstruct outer2 x (y (setf (inner-n *in*) (bad-value))))
(try (te (let ((v (read-from-string "#1=#S(outer2 :x #1#)"))) (list :accepted (inner-n *in*)))))
(try (inner-n *in*))
(defstruct tn (next nil :type (or null tn)) (v 0 :type integer))
(defstruct outer3 x (y (read-from-string "#1=#S(tn :next #1# :v #1#)")))
(try (te (let ((v (read-from-string "#1=#S(outer3 :x #1#)"))) (list :accepted (tn-p (tn-v (outer3-y v)))))))
(defstruct outer4 (x nil :type (or null outer4)) (y 5 :type integer))
(try (te (let ((v (read-from-string "#1=#S(outer4 :x #1# :y \"bad\")"))) (list :accepted (outer4-y v)))))
(try (te (let ((v (read-from-string "#1=#S(outer4 :x #1# :y 6)"))) (list (eq v (outer4-x v)) (outer4-y v)))))
(try (te (make-inner :n "bad")))
;; 4回目：reader macro が持ち出した #n# の仮の値を、initform が別の構築子・setf に渡したら、その場で type-error
;; （検査を省略するのは、reader が作っている構造体のスロットだけ）
(defvar *pending*)
(defvar *rt* (copy-readtable nil))
(set-macro-character #\! (lambda (s c) (declare (ignore c)) (setq *pending* (read s t nil t))) nil *rt*)
(defstruct outer5 x (y (make-inner :n *pending*)))
(try (te (let* ((*readtable* *rt*) (v (read-from-string "#1=#S(outer5 :x !#1#)")))
           (list :accepted (typep (inner-n (outer5-y v)) 'integer)))))
(defstruct (inner6 (:constructor make-inner6 (&aux (n *pending*)))) (n nil :type integer))
(defstruct outer6 x (y (make-inner6)))
(try (te (let* ((*readtable* *rt*) (v (read-from-string "#1=#S(outer6 :x !#1#)")))
           (list :accepted (typep (inner6-n (outer6-y v)) 'integer)))))
(defstruct outer7 x (y (setf (inner-n *in*) *pending*)))
(try (te (let* ((*readtable* *rt*) (v (read-from-string "#1=#S(outer7 :x !#1#)")))
           (list :accepted (typep (inner-n *in*) 'integer)))))
(try (integerp (inner-n *in*)))
;; 型のないスロットに入れるのはよい
(defstruct outer8 x (y (list *pending*)))
(try (te (let* ((*readtable* *rt*) (v (read-from-string "#1=#S(outer8 :x !#1#)"))) (eq v (outer8-x v)))))
;; 5回目：reader macro が、読んだ構造体の複製を返しても、元の構造体の型は確かめる
(defvar *rt2* (copy-readtable nil))
(set-macro-character #\! (lambda (s c) (declare (ignore c)) (copy-structure (read s t nil t))) nil *rt2*)
(defstruct rr (x nil :type (or null integer)))
(defstruct ok (x nil :type (or null ok)))
(try (te (let* ((*readtable* *rt2*) (v (read-from-string "#1=!#S(rr :x #1#)"))) (list :accepted (eq v (rr-x v))))))
(try (te (let* ((*readtable* *rt2*) (v (read-from-string "#1=!#S(ok :x #1#)"))) (list :accepted (eq v (ok-x v))))))
(try (te (let* ((*readtable* *rt2*) (v (read-from-string "!#S(rr :x 5)"))) (rr-x v))))
;; reader macro が、読んだ構造体を複製し、元の構造体だけを書き換えてから複製を返す：型に合う形は読める
;; （型に合わない形は、SBCL 2.6.7 は type-error、Zilisp は受理する。reader macro が作った構造体の型は reader macro の
;; 責任。単体テストと tests/differential/impl-dependent.toml。Codex のレビュー P26 6〜8回目）
(defvar *rt3* (copy-readtable nil))
(set-macro-character #\! (lambda (s c) (declare (ignore c))
                           (let* ((original (read s t nil t)) (copy (copy-structure original)))
                             (setf (ok-x original) nil)
                             copy))
                     nil *rt3*)
(try (te (let* ((*readtable* *rt3*) (v (read-from-string "#1=!#S(ok :x #1#)"))) (list :accepted (eq v (ok-x v))))))
;; 循環のない共有だけのラベルは、今までどおり
(try (let ((v (read-from-string "(#1=#S(point :x 1) #1# #2=(a) #2#)"))) (list (eq (car v) (cadr v)) (eq (caddr v) (cadddr v)))))
;; 6回目 #2：#S の型のエラーの後、同じストリームの続きを読める（位置が #S の直後まで進む）
(with-input-from-string (s "#1=#S(rr :x #1#) 42")
  (try (te (read s)))
  (try (file-position s))
  (try (read s)))
(with-input-from-string (s "#S(rr :x bad) 42")
  (try (te (read s)))
  (try (file-position s))
  (try (read s)))
(with-input-from-string (s "(1 #S(rr :x bad) 2) 42")
  (try (te (read s)))
  (try (file-position s))
  (try (read s)))
(with-input-from-string (s "#S(rr :x bad) 42")
  (try (handler-case (read s) (type-error () (list :after (read s))))))
(with-input-from-string (s "#S(rr :x bad) 42")
  (try (block b (handler-bind ((type-error (lambda (c) (declare (ignore c)) (return-from b (list :in-handler (read s)))))) (read s)))))
(with-input-from-string (s "#S(rr :bogus 1) 42")
  (try (handler-case (read s) (error () (list :after (read s))))))
;; 7回目 #1：#S の initform が同じストリームを読んだら、外側の読み取りはその続きから読む
(defvar *in-stream*)
(defstruct rd (x (read *in-stream*)))
(defstruct rd2 (x (read-char *in-stream*)) (y (read-line *in-stream*)))
(with-input-from-string (*in-stream* "(#S(rd) 11 22)") (try (read *in-stream*)))
(with-input-from-string (*in-stream* "#S(rd) 11 22") (try (list (read *in-stream*) (read *in-stream*))))
(with-input-from-string (*in-stream* "(#S(rd :x 5) 11 22)") (try (read *in-stream*)))
(with-input-from-string (*in-stream* (format nil "(#S(rd2)ab c~%11 22)")) (try (read *in-stream*)))
(with-input-from-string (*in-stream* "#1=(#S(rd) 11 #1# 22)") (try (let ((v (read *in-stream*))) (list (rd-x (car v)) (eq v (cadr v)) (caddr v)))))
;; 7回目 #2・#3：#n# と関係のない構造体は確かめ直さない。外側のラベルが残っていても、多くの構造体を読める
;; （データは小さくしてある：GC stress は確保のたびに GC を行うので、生きているデータが多いと、後ろの例がすべて遅くなる。
;; 6,400 個での時間の計測は、詳細設計の「Phase 26 の実装」にある）
(defvar *boxes* (loop repeat 30 collect (make-point :x (make-list 30))))
(try (let ((v (read-from-string "#1=(#2=(#1# #2# #.*boxes*))"))) (list (eq v (car (car v))) (eq (car v) (cadr (car v))) (length (caddr (car v))))))
;; 8回目 #1：#S の initform からの recursive な read は、外側の #n= のラベルを参照できる
(defstruct rdr (x (read *in-stream* t nil t)))
(with-input-from-string (*in-stream* "#1=(#S(rdr) #1#)") (try (let ((v (read *in-stream*))) (eq v (rdr-x (car v))))))
(with-input-from-string (*in-stream* "(#S(rdr) 7 8)") (try (read *in-stream*)))
(with-input-from-string (*in-stream* "(#1=(a) #S(rdr) #1# 9)") (try (let ((v (read *in-stream*))) (list (eq (car v) (rdr-x (cadr v))) (cddr v)))))
;; 多くの #S が同じラベルを指しても読める（検査待ちの構造体ごとに全体をたどり直さない）
(defstruct nl (x nil :type list))
(try (let* ((text (with-output-to-string (o)
                    (write-string "#1=(" o)
                    (dotimes (i 50) (write-string "#S(nl :x #1#) " o))
                    (write-string ")" o)))
            (v (read-from-string text)))
       (list (length v) (eq v (nl-x (car v))) (eq v (nl-x (car (last v)))))))
;; 9回目 #1：initform の recursive な read が #n# を取り込んでも、置き換えた後の値で型を確かめる
(defstruct rdl (x (read *in-stream* t nil t) :type list))
(defstruct rds (x (read *in-stream* t nil t) :type rds))
(with-input-from-string (*in-stream* "#1=#S(rdl) #1#") (try (te (let ((v (read *in-stream*))) (list :accepted (eq v (rdl-x v)))))))
(with-input-from-string (*in-stream* "#1=#S(rds) #1#") (try (te (let ((v (read *in-stream*))) (list :accepted (eq v (rds-x v)))))))
(with-input-from-string (*in-stream* "#1=(#S(rdl) #1#)") (try (te (let ((v (read *in-stream*))) (list :accepted (eq v (rdl-x (car v))) (cdr v))))))
(with-input-from-string (*in-stream* "(#S(rdl) (1 2) 3)") (try (te (read *in-stream*))))
(with-input-from-string (*in-stream* "(#S(rdl) 5 3)") (try (te (read *in-stream*))))
(with-input-from-string (*in-stream* "#1=(#S(rdl) 5 #1#)") (try (te (progn (read *in-stream*) :accepted))))
(with-input-from-string (*in-stream* "#1=(#S(rdl) (a) #1#)") (try (te (let ((v (read *in-stream*))) (list (rdl-x (car v)) (eq v (cadr v)))))))
;; 9回目 #2：initform の recursive な read は、外側の backquote の深さで読む
(defmacro re (form) `(handler-case (progn ,form :accepted) (reader-error () :reader-error)))
(with-input-from-string (*in-stream* "`(#S(rdr) ,x)") (try (re (read *in-stream*))))
(with-input-from-string (*in-stream* "(#S(rdr) ,x)") (try (re (read *in-stream*))))
(with-input-from-string (*in-stream* "``(#S(rdr) ,,x)") (try (re (read *in-stream*))))
(with-input-from-string (*in-stream* "`(#S(rdr) ,,x)") (try (re (read *in-stream*))))
;; 10回目 #5：backquote の中でも、#S の本体の中のコンマは reader-error。本体の中で新しく始めた backquote は読める
(try (re (read-from-string "`#S(point :x ,y)")))
(try (re (read-from-string "``#S(point :x ,,y)")))
(try (re (read-from-string "`(#S(point :x ,y))")))
(try (re (read-from-string "`(#S(point :x `(a ,b)))")))
(try (re (read-from-string "`(#S(point :x 1) ,y)")))
(try (re (read-from-string "#S(point :x ,y)")))
(try (point-x (cadr (read-from-string "`#S(point :x (a b))"))))
;; 11回目 #1：#S のすぐ後は ( でなければならない。本体は ( のマクロ文字の関数を通さずに読む
(let ((*readtable* (copy-readtable nil)))
  (set-macro-character #\( (lambda (s c) (declare (ignore s c)) (error "custom open")))
  (try (handler-case (point-x (read-from-string "#S(point :x 42)")) (error () :error))))
(defvar *seen* nil)
(try (re (read-from-string "#S#.(progn (setq *seen* t) '(point :x 42))")))
(try *seen*)
(try (re (read-from-string "#S (point :x 1)")))
(try (re (read-from-string "#S point")))
(try (re (read-from-string "#S'(point :x 1)")))
(try (handler-case (read-from-string "#S") (end-of-file () :end-of-file)))
(try (handler-case (read-from-string "#S(point :x 1") (end-of-file () :end-of-file)))
(try (let ((*read-suppress* t)) (read-from-string "#S(nosuch :x 1)")))
(try (let ((*read-suppress* t)) (read-from-string "(#S nosuch 2)")))
;; 本体の読み取りがエラーで抜けた後も、同じストリームの続きを読める
(with-input-from-string (s "`#S(point :x ,y) `(a ,b)")
  (try (list (re (read s)) (re (read s)) (re (read s)) (re (read s)))))
;; 12回目 #1：リストを閉じるのは文字 ) そのもの。) に設定した reader macro は呼ばず、) の構文を写した文字は閉じない
(defvar *close-seen* nil)
(let ((*readtable* (copy-readtable nil)))
  (set-macro-character #\) (lambda (s c) (declare (ignore s c)) (setq *close-seen* t) (values)))
  (try (re (point-x (read-from-string "#S(point :x 42)"))))
  (try (handler-case (list (point-x (read-from-string "#S(point :x 42)"))
                           (read-from-string "(1 (2 . 3) #(4 5) ; c
)")
                           (read-from-string "(a . b #| c |# )")
                           *close-seen*)
         (error () :error))))
(let ((*readtable* (copy-readtable nil)))
  (set-syntax-from-char #\] #\))
  (try (re (read-from-string "#S(point :x 42]")))
  (try (re (read-from-string "(1 2]")))
  (try (re (read-from-string "#(1 2]")))
  (try (re (read-from-string "(1 . 2]")))
  (try (re (read-from-string "(1 . ]")))
  (try (with-input-from-string (s "1 2] 3") (list (read-delimited-list #\] s) (read s)))))
(try (with-input-from-string (s "1 ; c
] 3")
       (list (read-delimited-list #\] s) (read s))))
(try (re (read-from-string "(1 . )")))
(try (re (read-from-string "(1 . 2 3)")))
(try (re (read-from-string "( . 2)")))
(try (let ((*read-suppress* t)) (read-from-string "(1 . ) 5")))
(try (let ((*read-suppress* t)) (read-from-string "( . 2) 5")))
;; 12回目 #2：#S の後の ( でない文字も読んでからエラーにする（エラーの後の位置）
(with-input-from-string (s "#S! 42")
  (try (list (re (read s)) (file-position s) (read s))))
(with-input-from-string (s "#S point 42")
  (try (list (re (read s)) (file-position s) (read s))))
(with-input-from-string (s "#S (point :x 1) 42")
  (try (list (re (read s)) (file-position s) (read s) (read s))))
;; 13回目 #1：読み飛ばしの中では、単独のドットもふつうのトークン（ドット対の検査をしない）
(defun probe (text)
  (handler-case (multiple-value-list (read-from-string text))
    (reader-error () :reader-error)))
(try (probe "#+no-such-feature (a . b c) 42"))
(try (probe "#+no-such-feature (a . . b) 42"))
(try (probe "#+no-such-feature #S(. a b) 42"))
(try (probe "(1 #+no-such-feature . 2)"))
(try (probe "(1 #-no-such-feature . 2)"))
(try (let ((*read-suppress* t)) (probe "(a . .)")))
(try (let ((*read-suppress* t)) (probe "#S(. a b)")))
(try (let ((*read-suppress* t)) (probe "#(. )")))
(try (let ((*read-suppress* t)) (probe ". 5")))
(try (probe "(a . b c)"))
(try (probe "#(a . b)"))
;; 13回目 #2：backquote の中で、ドットのすぐ後の ,@ / ,. は reader-error
(try (re (read-from-string "`(a . ,@b)")))
(try (re (read-from-string "`(a . ,.b)")))
(try (re (read-from-string "`(a . ,b)")))
(try (re (read-from-string "`(a . (,@b))")))
(try (re (read-from-string "`(a . `(,@b))")))
(try (re (read-from-string "``(a . ,,@b)")))
(try (re (read-from-string "``(a . ,@,b)")))
(try (re (read-from-string "`(a ,@b . c)")))
(try (re (read-from-string "`(a . #(,@b))")))
(try (re (read-from-string "#S(point :x `(a . ,@b))")))
(try (re (read-from-string "#S(point :x `(a . ,b))")))
(try (probe "#+no-such-feature `(a . ,@b) 42"))
(try (let ((b '(1 2))) (declare (special b)) (eval (read-from-string "`(a . ,b)"))))
