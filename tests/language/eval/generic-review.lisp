;; P28 Claude Code review regressions; SBCL 2.6.10.168.
(defmethod gr-key ((x integer) &key a) a)
(defmethod gr-key ((x string) &key b) b)
(print (list (gr-key 1 :a 2) (gr-key "s" :b 3)))
(defmethod gr-rest ((x integer) &key a &allow-other-keys) a)
(defmethod gr-rest ((x string) &rest r) r)
(print (handler-case (gr-rest "s" :a 1) (error () :unknown-key)))
(print (with-output-to-string (s) (print-object 42 s)))
(print (let ((*print-readably* t)) (with-output-to-string (s) (print-object '(42 "s") s))))
(defun gr-ordinary (x) x)
(print (handler-case (eval '(defclass gr-retry () ((x :accessor gr-ordinary)))) (program-error () :ordinary)))
(defclass gr-retry () ((x :initform 7 :accessor gr-good)))
(print (gr-good (make-instance 'gr-retry)))
(defgeneric gr-bad-arity (x y))
(print (handler-case (eval '(defclass gr-retry-arity () ((x :reader gr-bad-arity)))) (program-error () :arity)))
(defclass gr-retry-arity () ())
(print (class-name (find-class 'gr-retry-arity)))
(defgeneric gr-inline (x) (:method ((x integer)) :inline))
(defmethod gr-inline ((x symbol)) :external)
(defgeneric gr-inline (x) (:method ((x string)) :string))
(print (list (handler-case (gr-inline 1) (error () :no-method)) (gr-inline "s") (gr-inline 's)))
;; Replacing an inline method externally must preserve the replacement.
(defgeneric gr-replace (x) (:method ((x integer)) :inline))
(defmethod gr-replace ((x integer)) :external)
(defgeneric gr-replace (x))
(print (gr-replace 1))
(defgeneric gr-singletons (x &optional (y) &key (a) ((:bee b))))
(defmethod gr-singletons ((x integer) &optional (y 2) &key (a 3) ((:bee b) 4)) (list x y a b))
(print (list (gr-singletons 1) (gr-singletons 1 5 :a 6 :bee 7)))
(defmethod gr-meta ((x t)) x)
(defmethod print-object ((x standard-generic-function) s) (write-string "GF" s))
(defmethod print-object ((x standard-method) s) (write-string "METHOD" s))
(defmethod print-object ((x class) s) (write-string "CLASS" s))
(print (list (write-to-string #'gr-meta)
             (write-to-string (find-method #'gr-meta nil (list (find-class t))))
             (write-to-string (find-class 'integer))))
(let ((*print-pretty* nil))
  (print (write-to-string (list #'gr-meta (find-class 'integer)))))
