;; ハッシュ表の並べ方（Phase 21.6）：maphash・loop の順序を SBCL 2.6.7 とそろえる（枠の番号の順、削除した枠の再利用、
;; flat の表と大きさの境目）。期待値は SBCL 2.6.7 と同じ出力
(setq *print-pretty* nil)
(defun keys (h) (let ((r nil)) (maphash (lambda (k v) (declare (ignore v)) (push k r)) h) (nreverse r)))
(defun fill-h (h n) (dotimes (i n h) (setf (gethash (format nil "k~d" i) h) i)))
;; 1. 入れた順
(let ((h (make-hash-table :test 'equal))) (fill-h h 5) (print (keys h)))
(let ((h (make-hash-table))) (dolist (k '(c a b z y)) (setf (gethash k h) t)) (print (keys h)))
;; 2. 大きくした後も入れた順
(let ((h (make-hash-table :test 'equal))) (fill-h h 40) (print (keys h)))
(let ((h (make-hash-table))) (dotimes (i 100) (setf (gethash i h) i)) (print (keys h)))
;; 3. equal の表（flat でない）：削除の後に入れる
(let ((h (make-hash-table :test 'equal))) (fill-h h 6)
  (remhash "k1" h) (remhash "k3" h) (setf (gethash "x" h) 0 (gethash "y" h) 0 (gethash "z" h) 0) (print (keys h)))
(let ((h (make-hash-table :test 'equalp))) (fill-h h 30)
  (dolist (k '("k2" "k20" "k7")) (remhash k h)) (dolist (k '("a" "b" "c" "d")) (setf (gethash k h) 1)) (print (keys h)))
;; 4. eql の表で 16 を超える大きさ（SBCL は flat でない）
(let ((h (make-hash-table :size 100))) (dotimes (i 10) (setf (gethash i h) i))
  (remhash 3 h) (remhash 5 h) (setf (gethash 'a h) 1 (gethash 'b h) 2 (gethash 'c h) 3) (print (keys h)))
;; 5. clrhash の後
(let ((h (make-hash-table :test 'equal))) (fill-h h 5) (clrhash h) (setf (gethash "q" h) 1 (gethash "p" h) 2) (print (keys h)))
;; 6. loop の hash-keys・hash-values
(let ((h (make-hash-table :test 'equal))) (fill-h h 5)
  (print (loop for k being the hash-keys of h collect k))
  (print (loop for k being the hash-keys of h using (hash-value v) collect (cons k v))))
;; 7. maphash の中での remhash・setf
(let ((h (make-hash-table))) (dotimes (i 8) (setf (gethash i h) i))
  (maphash (lambda (k v) (if (evenp k) (remhash k h) (setf (gethash k h) (* v 10)))) h)
  (print (list (hash-table-count h) (keys h) (loop for k being the hash-keys of h using (hash-value v) collect v))))
;; 8. flat（小さい eql の表）の削除の後（空いている枠のうち、いちばん番号の大きいものを使う）
(let ((h (make-hash-table))) (dolist (k '(a b c d)) (setf (gethash k h) t))
  (remhash 'c h) (remhash 'b h) (setf (gethash 'e h) t (gethash 'f h) t) (print (keys h)))
;; 9. flat と大きさの境目（eql 16・eq 32、:size の指定）で削除と挿入を混ぜる
(defun churn (h n)
  (dotimes (i n) (setf (gethash i h) i))
  (loop for i from 0 below n by 3 do (remhash i h))
  (dotimes (i 5) (setf (gethash (+ 1000 i) h) i))
  (loop for i from 1 below n by 4 do (remhash i h))
  (dotimes (i 7) (setf (gethash (+ 2000 i) h) i))
  (keys h))
(let ((*print-pretty* nil))
  (dolist (n '(3 6 8 9 12 16 17 20 25 32 33 40 60))
    (print (list n (churn (make-hash-table) n)))
    (print (list :eq n (churn (make-hash-table :test 'eq) n)))
    (print (list :equal n (churn (make-hash-table :test 'equal) n))))
  (dolist (s '(0 1 5 7 10 15 16 17 31 32 33 100))
    (print (list :size s (churn (make-hash-table :size s) 24)))
    (print (list :eq-size s (churn (make-hash-table :test 'eq :size s) 40)))))
;; 10. 大きな表：削除と挿入を繰り返しても項目を失わない（equal・equalp・eql）
(dolist (test '(eql equal equalp))
  (let ((h (make-hash-table :test test)) (sum 0))
    (dotimes (i 1200) (setf (gethash (if (eq test 'eql) i (list i (format nil "s~d" i))) h) i))
    (dotimes (i 1200) (when (oddp i) (remhash (if (eq test 'eql) i (list i (format nil "s~d" i))) h)))
    (dotimes (i 400) (setf (gethash (if (eq test 'eql) (+ i 5000) (list (+ i 5000) "x")) h) i))
    (maphash (lambda (k v) (declare (ignore k)) (incf sum v)) h)
    (print (list test (hash-table-count h) sum
                 (gethash (if (eq test 'eql) 1198 (list 1198 "s1198")) h)
                 (gethash (if (eq test 'eql) 1199 (list 1199 "s1199")) h)))))
;; 11. equalp の表：大文字・小文字と数の型をそろえる（作り直しの後も）
(let ((h (make-hash-table :test 'equalp)))
  (dotimes (i 50) (setf (gethash (format nil "Key~d" i) h) i))
  (setf (gethash 1 h) 'one (gethash #\A h) 'a)
  (print (list (gethash "KEY7" h) (gethash "key49" h) (gethash 1.0 h) (gethash #\a h) (hash-table-count h))))
;; 12. equalp で表を比べる（削除した枠を飛ばす）、clrhash の後、すべて削除した後、数のキー
(let ((a (make-hash-table :test 'equal)) (b (make-hash-table :test 'equal)))
  (dotimes (i 20) (setf (gethash (format nil "~d" i) a) i))
  (dotimes (i 20) (when (evenp i) (remhash (format nil "~d" i) a)))
  (loop for i from 19 downto 0 when (oddp i) do (setf (gethash (format nil "~d" i) b) i))
  (print (list (equalp a b) (hash-table-count a) (hash-table-count b)))
  (setf (gethash "1" b) 100)
  (print (equalp a b)))
(let ((h (make-hash-table)))
  (dotimes (i 20) (setf (gethash i h) i))
  (clrhash h)
  (dotimes (i 3) (setf (gethash (* 10 i) h) i))
  (print (list (hash-table-count h) (keys h) (gethash 5 h))))
(let ((h (make-hash-table :test 'eq)))
  (dolist (k '(a b c)) (setf (gethash k h) 1))
  (remhash 'a h) (remhash 'b h) (remhash 'c h)
  (print (list (hash-table-count h) (keys h)))
  (dolist (k '(x y z w)) (setf (gethash k h) 2))
  (print (keys h)))
(let ((h (make-hash-table :test 'equal)))
  (dotimes (i 3) (setf (gethash i h) i))
  (remhash 0 h) (remhash 1 h) (remhash 2 h)
  (setf (gethash 'p h) 1 (gethash 'q h) 2 (gethash 'r h) 3 (gethash 's h) 4)
  (print (keys h)))
(let ((h (make-hash-table)))
  (setf (gethash 1.5d0 h) 'a (gethash (expt 2 70) h) 'b (gethash 1/3 h) 'c)
  (dotimes (i 30) (setf (gethash (+ i 100) h) i))
  (print (list (gethash 1.5d0 h) (gethash (expt 2 70) h) (gethash 1/3 h) (hash-table-count h))))
;; 13. :rehash-size を指定した表（SBCL と同じ規則で大きくする。Codex のレビュー P21.6 #3）と、clrhash を続けた後
(dolist (rs '(1 2 5 10 100 1.1 1.5 2.0 3.0 1.01))
  (dolist (n '(9 17 20 40))
    (print (list rs n (churn (make-hash-table :rehash-size rs) n)
                 (churn (make-hash-table :test 'eq :rehash-size rs) (* 2 n))
                 (churn (make-hash-table :test 'equal :rehash-size rs) n)))))
(let ((h (make-hash-table :rehash-size 10)))
  (dotimes (i 9) (setf (gethash i h) i))
  (remhash 8 h)
  (remhash 0 h)
  (setf (gethash 100 h) 100)
  (print (loop for k being the hash-keys of h collect k)))
(let ((h (make-hash-table :size 20)))
  (dotimes (i 5) (setf (gethash i h) i))
  (clrhash h) (clrhash h)
  (dotimes (i 3) (setf (gethash (+ 10 i) h) i))
  (remhash 11 h) (setf (gethash 99 h) 0)
  (print (list (hash-table-count h) (loop for k being the hash-keys of h collect k))))
