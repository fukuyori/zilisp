;; *print-pretty* の初期値（Phase 24）：印字の変数を変えずに、print・prin1・princ・format・write-to-string などの
;; 出力が SBCL と同じになるかを確かめる互換試験。期待値は SBCL 2.6.7（--script）と同じ出力
(print *print-pretty*)
(print *print-right-margin*)
;; quote・function・backquote の形
(print ''x)
(print '#'car)
(print '(a 'b #'c))
(print (list 'quote 'a 'b))
(print '(quote))
(prin1 ''(1 2)) (terpri)
(princ ''"str") (terpri)
(print (prin1-to-string ''y))
(print (princ-to-string '(quote "s")))
(print (write-to-string ''z))
(print (write-to-string ''z :pretty nil))
(print (format nil "~a ~s ~w" ''a ''b ''c))
;; 80 桁で折り返す長いリスト・入れ子・ベクタ
(print (make-list 40 :initial-element 'abc))
(print (loop for i below 60 collect i))
(print (list (make-list 15 :initial-element 'alpha) (make-list 15 :initial-element 'beta)))
(print (make-array 50 :initial-element 'vec))
(print (make-array '(4 12) :initial-element 'cell))
(print (list "a long string number one" "a long string number two" "a long string number three" "four"))
(print '(alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho . sigma))
;; コードの形
(print '(defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2))))))
(print '(let ((alpha (list 1 2 3 4 5)) (beta (list 6 7 8 9 10)) (gamma (list 11 12 13 14 15))) (mapcar #'+ alpha beta gamma)))
(print '(loop for i from 0 below 100 when (evenp i) collect (* i i) into squares finally (return (reduce #'+ squares))))
(print '(cond ((null list) nil) ((atom list) (list list)) (t (append (flatten (car list)) (flatten (cdr list))))))
;; 文字列への出力・format の ~a ~s で長いもの
(print (format nil "~a" (make-list 30 :initial-element 'word)))
(print (format nil "~s" (make-list 30 :initial-element "s")))
(print (length (prin1-to-string (make-list 40 :initial-element 'abc))))
(print (with-output-to-string (s) (print (make-list 30 :initial-element 'xyz) s)))
;; 短いものは変わらない
(print '(1 2 3))
(print #(1 2 3))
(print "string")
(print #\a)
(print 1.5)
(print '(1 . 2))
(print (cons 'a (cons 'b 'c)))
(princ (list "a" #\b 'c)) (terpri)
(write '(x y) :pretty nil) (terpri)
(write '(defun f (x) x) :right-margin 10) (terpri)
;; *print-length*・*print-level* と組み合わせる
(let ((*print-length* 5)) (print (loop for i below 100 collect i)))
(let ((*print-level* 2)) (print '(a (b (c (d))))))
(let ((*print-circle* t) (x (list 1 2))) (print (list x x)))
(terpri)
