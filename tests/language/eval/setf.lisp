;; setf と場所・ハッシュ表・配列（Phase 16）
;; 変数とリストの場所
(let ((a 1) (b 2))
  (setf a 10 b 20)
  (print (list a b)))
(let ((l (list 1 2 3 4)))
  (setf (car l) 'a (cadr l) 'b (nth 2 l) 'c (fourth l) 'd)
  (print l))
(let ((l (list 1 2 3)))
  (incf (car l) 10)
  (decf (third l))
  (print l))

;; ハッシュ表（教材で最も多い使い方：:test 'equal と、gethash の setf・incf・push）
(defparameter *counts* (make-hash-table :test 'equal))
(defun count-word (w) (incf (gethash w *counts* 0)))
(count-word "apple")
(count-word "pear")
(count-word "apple")
(print (list (gethash "apple" *counts*) (gethash "pear" *counts*) (gethash "plum" *counts*)
             (hash-table-count *counts*)))
(let ((groups (make-hash-table)))
  (push 'x (gethash 'odd groups))
  (push 'y (gethash 'odd groups))
  (push 'z (gethash 'even groups))
  (print (list (gethash 'odd groups) (gethash 'even groups))))
(let ((h (make-hash-table)) (total 0))
  (setf (gethash 'a h) 1 (gethash 'b h) 2 (gethash 'c h) 3)
  (remhash 'b h)
  (maphash (lambda (k v) (declare (ignore k)) (setq total (+ total v))) h)
  (print (list total (hash-table-count h) (gethash 'b h 'gone))))

;; 配列と文字列
(let ((v (make-array 3 :initial-element 0)))
  (setf (aref v 0) 'first)
  (incf (aref v 2) 5)
  (print (list v (length v))))
(let ((s (make-array 3 :element-type 'character :initial-element #\-)))
  (setf (char s 1) #\+)
  (print s))

;; 属性リスト
(let ((plist (list :name "Alice")))
  (setf (getf plist :age) 30)
  (setf (getf plist :name) "Bob")
  (print (list (getf plist :name) (getf plist :age) (getf plist :email 'none))))
(setf (get 'robot 'color) 'silver)
(print (get 'robot 'color))

;; setf 関数と defsetf
(defun (setf middle) (new v) (setf (aref v 1) new))
(let ((v (vector 1 2 3)))
  (setf (middle v) 'm)
  (print v))
(defun box-value (b) (car b))
(defsetf box-value (b) (new) `(setf (car ,b) ,new))
(let ((box (list 'old)))
  (setf (box-value box) 'new)
  (print box))
(terpri)
