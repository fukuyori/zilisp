;; ストリーム（Phase 23）：ファイル・文字列のストリーム、読み書きの関数。期待値は SBCL 2.6.7 と同じ出力。
;; 作業ディレクトリはリポジトリの直下。作るファイルは .zig-cache/lang-tmp/ の下（出力に絶対パスは出さない）
(setq *print-pretty* nil)
(defvar *dir* ".zig-cache/lang-tmp/streams/")
(ensure-directories-exist *dir*)
(defun f (name) (concatenate 'string *dir* name))
(dolist (n '("t1.txt" "t2.lisp" "b.bin" "u8.txt")) (when (probe-file (f n)) (delete-file (f n))))

;; 書いて読む
(print (with-open-file (s (f "t1.txt") :direction :output)
         (write-line "abc" s) (format s "x~a~%" 1) (princ 42 s) (terpri s) (write-string "end" s) :ok))
(print (with-open-file (s (f "t1.txt"))
         (list (read-line s) (read-line s) (read-line s) (multiple-value-list (read-line s)) (read-line s nil :eof))))
(print (with-open-file (s (f "t1.txt") :direction :output :if-exists :append) (write-string "+tail" s)))
(print (with-open-file (s (f "t1.txt")) (let ((r nil)) (loop for l = (read-line s nil) while l do (push l r)) (nreverse r))))
(print (with-open-file (s (f "t1.txt"))
         (list (read-char s) (peek-char nil s) (read-char s) (progn (unread-char #\b s) (read-char s)) (file-position s) (file-length s))))
(print (with-open-file (s (f "nope.txt") :if-does-not-exist nil) s))
(print (with-open-file (s (f "t1.txt") :direction :output :if-exists nil) s))
(print (let ((s (open (f "t1.txt")))) (close s) (list (open-stream-p s) (close s))))
(print (with-open-file (s (f "t1.txt"))
         (list (streamp s) (input-stream-p s) (output-stream-p s) (stream-element-type s) (interactive-stream-p s)
               (pathname-name (pathname s)) (pathname-type (truename s)))))
(print (with-open-file (s (f "t1.txt") :direction :output :if-exists :supersede) (write-string "new" s)))
(print (with-open-file (s (f "t1.txt")) (read-line s)))
(print (let ((s (open (f "t1.txt")))) (unwind-protect (listen s) (close s))))
(print (with-open-file (s (f "t1.txt") :direction :probe) (list (streamp s) (open-stream-p s))))

;; read・print
(with-open-file (s (f "t2.lisp") :direction :output) (print '(a b "c" 1.5) s) (print :k s) (prin1 'sym s))
(print (with-open-file (s (f "t2.lisp")) (list (read s) (read s) (read s) (read s nil :eof) (read s nil :eof))))
(print (with-open-file (s (f "t2.lisp")) (let ((r nil)) (loop for x = (read s nil :eof) until (eq x :eof) do (push x r)) (nreverse r))))

;; バイナリ
(with-open-file (s (f "b.bin") :direction :output :element-type '(unsigned-byte 8)) (dolist (b '(0 1 255 128)) (write-byte b s)))
(print (with-open-file (s (f "b.bin") :element-type '(unsigned-byte 8))
         (list (read-byte s) (read-byte s) (read-byte s) (read-byte s) (read-byte s nil :eof) (file-length s) (stream-element-type s))))
(print (with-open-file (s (f "b.bin") :element-type '(unsigned-byte 8))
         (let ((v (make-array 6 :element-type '(unsigned-byte 8) :initial-element 9))) (list (read-sequence v s) v))))

;; UTF-8
(with-open-file (s (f "u8.txt") :direction :output :external-format :utf-8) (write-line "日本語" s))
(print (with-open-file (s (f "u8.txt") :external-format :utf-8) (let ((l (read-line s))) (list (length l) (char-code (char l 0)) (file-length s)))))
(print (with-open-file (s (f "u8.txt")) (list (char-code (read-char s)) (file-position s))))

;; 文字列のストリーム
(print (with-output-to-string (s) (write-string "ab" s) (print 1 s) (format s "~a" 2)))
(print (with-output-to-string (*standard-output*) (princ "x") (print 'y)))
(print (with-input-from-string (s "12 (a b) \"c\"") (list (read s) (read s) (read s) (read s nil :e))))
(print (with-input-from-string (s (format nil "line1~%line2")) (list (read-line s) (read-line s) (read-line s nil :e))))
(print (multiple-value-list (read-from-string "(1 2) 3")))
(print (multiple-value-list (read-from-string "  abc  def")))
(print (multiple-value-list (read-from-string "" nil :none)))
(print (multiple-value-list (read-from-string "abc def" t nil :start 4)))
(print (list (prin1-to-string "a") (princ-to-string "a") (write-to-string 'x) (write-to-string "q" :escape nil)))
(print (let ((s (make-string-output-stream))) (write-string "ab" s) (list (get-output-stream-string s) (get-output-stream-string s))))
(print (let ((s (make-string-input-stream "hello" 1 3))) (list (read-char s) (read-char s) (read-char s nil :e))))
(print (list (streamp (make-string-input-stream "x")) (streamp 1)))
(print (let ((s (make-broadcast-stream))) (write-string "lost" s) :ok))
(print (with-output-to-string (s) (fresh-line s) (write-string "a" s) (fresh-line s) (fresh-line s) (write-string "b" s)))
(print (with-output-to-string (s) (write "q" :stream s :escape nil) (write "q" :stream s)))
(print (with-output-to-string (s) (let ((b (make-broadcast-stream s s))) (write-string "x" b))))
(print (with-output-to-string (s) (let ((two (make-two-way-stream (make-string-input-stream "in") s))) (write-string (read-line two) two))))
(print (list (streamp *standard-output*) (streamp *standard-input*) (streamp *terminal-io*) (output-stream-p *error-output*)))
(print (with-input-from-string (s "  x") (list (peek-char t s) (read-char s))))
(print (with-input-from-string (s "abc,def") (list (peek-char #\, s) (read-char s) (read-line s))))
(print (with-output-to-string (s) (write-sequence "hello" s :start 1 :end 3)))
(print (let ((v (make-string 3 :initial-element #\-))) (with-input-from-string (s "xy") (list (read-sequence v s) v))))

;; 標準出力
(write-char #\x)
(write-string "yz")
(write-line "w")
(print (list (terpri) (fresh-line) (fresh-line) (finish-output) (force-output) (clear-output)))
(format t "~&a~%")
(format t "~&b")
(format t "~&c~%")
(dolist (n '("t1.txt" "t2.lisp" "b.bin" "u8.txt")) (when (probe-file (f n)) (delete-file (f n))))
(print (probe-file (f "t1.txt")))
;; Codex のレビュー P23 の修正
;; #1 :if-exists :rename は「名前.bak」に退避する。:rename-and-delete は閉じるときに退避したものを消す
(dolist (n '("r.txt" "r.txt.bak")) (when (probe-file (f n)) (delete-file (f n))))
(with-open-file (s (f "r.txt") :direction :output) (write-string "old" s))
(print (with-open-file (s (f "r.txt") :direction :output :if-exists :rename) (write-string "new" s)))
(print (list (with-open-file (s (f "r.txt")) (read-line s)) (with-open-file (s (f "r.txt.bak")) (read-line s))))
(print (with-open-file (s (f "r.txt") :direction :output :if-exists :rename) (write-string "new2" s)))
(print (with-open-file (s (f "r.txt.bak")) (read-line s)))
(print (with-open-file (s (f "r.txt") :direction :output :if-exists :rename-and-delete) (write-string "new3" s)))
(print (list (with-open-file (s (f "r.txt")) (read-line s)) (probe-file (f "r.txt.bak"))))
;; #8 :overwrite の file-length は、元のファイルの長さから
(print (with-open-file (s (f "r.txt") :direction :output :if-exists :overwrite)
         (list (file-length s) (progn (write-string "X" s) (file-position s)) (file-length s))))
(print (with-open-file (s (f "r.txt")) (read-line s)))
;; #3 CR LF は変換しない（CR も文字）。Latin-1 の read
(with-open-file (s (f "crlf.txt") :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
  (dolist (b (map 'list #'char-code (concatenate 'string "\"a" (string #\Return) (string #\Newline) "b\" x"))) (write-byte b s)))
(print (with-open-file (s (f "crlf.txt")) (list (length (read s)) (file-position s) (read s) (file-position s))))
(print (with-open-file (s (f "crlf.txt")) (list (read-line s) (file-position s) (read-line s) (file-position s))))
(print (with-open-file (s (f "crlf.txt")) (list (char-code (read-char s)) (char-code (read-char s)) (char-code (read-char s)))))
(with-open-file (s (f "l1.txt") :direction :output :if-exists :supersede :external-format :latin-1)
  (write-string (concatenate 'string "\"" (string (code-char 233)) "\" sym") s))
(print (with-open-file (s (f "l1.txt") :external-format :latin-1)
         (list (char-code (char (read s) 0)) (read s) (file-position s) (file-length s))))
;; #15 synonym の問い合わせは指している先に任せる
(print (let ((*standard-input* (make-string-input-stream "x")))
         (let ((s (make-synonym-stream '*standard-input*)))
           (list (input-stream-p s) (output-stream-p s) (stream-element-type s) (file-position s) (open-stream-p s)))))
(print (with-open-file (in (f "r.txt")) (let ((*standard-input* in)) (file-length (make-synonym-stream '*standard-input*)))))
;; #6 閉じた two-way・synonym
(print (let ((s (make-two-way-stream (make-string-input-stream "abc") (make-string-output-stream))))
         (close s) (list (open-stream-p s) (open-stream-p (two-way-stream-input-stream s)))))
;; #7 read-char-no-hang（文字列のストリームは read-char と同じ）
(print (with-input-from-string (s "ab") (list (read-char-no-hang s) (read-char-no-hang s) (read-char-no-hang s nil :e))))
;; #5 broadcast：write-byte・finish-output を伝える。要素の型は最後のストリームの型（空なら T）
(print (let ((b (make-broadcast-stream))) (list (input-stream-p b) (output-stream-p b) (stream-element-type b) (file-length b))))
(print (with-open-file (f1 (f "bb.bin") :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
         (let ((b (make-broadcast-stream f1))) (list (write-byte 65 b) (stream-element-type b)))))
(print (with-open-file (r (f "bb.bin") :element-type '(unsigned-byte 8)) (list (read-byte r) (read-byte r nil :eof))))
(with-open-file (f1 (f "bc.txt") :direction :output :if-exists :supersede)
  (let ((b (make-broadcast-stream f1))) (write-string "abc" b) (finish-output b)
    (print (with-open-file (r (f "bc.txt")) (read-line r nil :empty)))))
(print (let ((s (make-string-output-stream)))
         (let ((b (make-broadcast-stream s))) (write-string "q" b) (finish-output b) (force-output b) (get-output-stream-string s))))
(dolist (n '("r.txt" "crlf.txt" "l1.txt" "bb.bin" "bc.txt")) (delete-file (f n)))
