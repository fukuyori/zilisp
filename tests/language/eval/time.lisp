;; 時刻（CLHS 25.1.4）：decode-universal-time・encode-universal-time・get-universal-time・get-decoded-time。
;; 期待値は SBCL 2.6.7 と同じ出力（その土地の時刻と今の年によって変わるものは、値の形だけを確かめる）

(defmacro try (form)
  `(handler-case (print (multiple-value-list ,form))
     (error (c) (format t "~%ERR ~A" (typep c 'type-error)))))

(try (decode-universal-time 0 0))
(try (decode-universal-time 3944123456 -9))
(try (decode-universal-time 3944123456 0))
(try (decode-universal-time 3944123456 5/2))
(try (decode-universal-time 3944123456 -13/4))
(try (decode-universal-time -1 0))
(try (decode-universal-time 100 9))
(try (decode-universal-time (expt 10 12) 0))
(try (decode-universal-time (expt 10 20) 0))
(try (decode-universal-time 1.5 0))
(try (decode-universal-time 0 25))
(try (decode-universal-time 0 1.5))
(try (encode-universal-time 0 0 0 1 1 1900 0))
(try (encode-universal-time 59 59 23 31 12 2025 0))
(try (encode-universal-time 0 0 0 29 2 2024 0))
(try (encode-universal-time 0 0 0 29 2 2023 0))
(try (encode-universal-time 0 0 0 31 4 2023 0))
(try (encode-universal-time 0 0 0 1 3 2100 0))
(try (encode-universal-time 0 0 0 1 3 2000 0))
(try (encode-universal-time 0 0 0 1 1 1900 -9))
(try (encode-universal-time 0 0 0 1 1 1899 0))
(try (encode-universal-time 0 0 0 1 1 1899 24))
(try (encode-universal-time 0 0 0 1 1 1898 0))
(try (encode-universal-time 0 0 0 1 1 150 0))
(try (encode-universal-time 60 0 0 1 1 2000 0))
(try (encode-universal-time 0 60 0 1 1 2000 0))
(try (encode-universal-time 0 0 24 1 1 2000 0))
(try (encode-universal-time 0 0 0 0 1 2000 0))
(try (encode-universal-time 0 0 0 32 1 2000 0))
(try (encode-universal-time 0 0 0 1 13 2000 0))
(try (encode-universal-time 0 0 0 1 0 2000 0))
(try (encode-universal-time 0 0 0 1 1 2000 1/2))
(try (encode-universal-time 0 0 0 1 1 2000 1.5))
(try (encode-universal-time 0 0 0 1 1 2000 30))
(try (encode-universal-time 1.0 0 0 1 1 2000 0))
(try (encode-universal-time 0 0 0 1 1 3000 0))
;; time-zone を秒にした値が整数でなければ type-error（Codex のレビュー P26 1回目 #4）
(try (decode-universal-time 3944123456 1/7))
(try (decode-universal-time 3944123456 1/7200))
(try (decode-universal-time 3944123456 1/3600))
(try (encode-universal-time 0 0 0 1 1 2000 1/7))
(try (encode-universal-time 0 0 0 1 1 2000 1/3600))
;; その土地の時刻：往復すると元に戻る
(try (let ((u (encode-universal-time 1 2 3 4 5 1950))) (subseq (multiple-value-list (decode-universal-time u)) 0 6)))
(try (let ((u (encode-universal-time 0 0 0 1 1 3000))) (subseq (multiple-value-list (decode-universal-time u)) 0 6)))
(try (let ((u (encode-universal-time 30 15 12 10 11 2026))) (subseq (multiple-value-list (decode-universal-time u)) 0 6)))
;; 2 桁の年は今の年の前後 50 年
(try (let ((y (nth-value 5 (decode-universal-time (encode-universal-time 0 0 0 1 1 30 0) 0)))
           (now (nth-value 5 (get-decoded-time))))
       (list (mod y 100) (<= (abs (- y now)) 50))))
(try (integerp (get-universal-time)))
(try (> (get-universal-time) 3970000000))
(try (length (multiple-value-list (get-decoded-time))))
(try (equal (subseq (multiple-value-list (get-decoded-time)) 5 6)
            (subseq (multiple-value-list (decode-universal-time (get-universal-time))) 5 6)))
(try (multiple-value-bind (s mi h d mo y dow dst zone) (get-decoded-time)
       (list (typep s '(mod 60)) (typep mi '(mod 60)) (typep h '(mod 24)) (typep d '(integer 1 31))
             (typep mo '(integer 1 12)) (integerp y) (typep dow '(mod 7)) (typep dst 'boolean) (typep zone '(rational -24 24)))))
