;; P29 lifecycle and standard method combination, SBCL 2.6.10.168.
(defvar *life-log* nil)
(defun life-log (x) (push x *life-log*))
(defclass life-base () ((x :initarg :x :initform 1 :accessor life-x)))
(defclass life-child (life-base) ())
(defmethod life-call ((x life-base)) (life-log :base) (values :result 2 3))
(defmethod life-call ((x life-child)) (life-log :child) (call-next-method))
(defmethod life-call :before ((x life-base)) (life-log :before-base))
(defmethod life-call :before ((x life-child)) (life-log :before-child))
(defmethod life-call :after ((x life-base)) (life-log :after-base) (values :ignored 9))
(defmethod life-call :after ((x life-child)) (life-log :after-child))
(defmethod life-call :around ((x life-base)) (life-log :around-base) (call-next-method))
(defmethod life-call :around ((x life-child)) (life-log :around-child) (call-next-method))
(let ((*life-log* nil))
  (print (multiple-value-list (life-call (make-instance 'life-child))))
  (print (reverse *life-log*)))
(print (method-qualifiers (find-method #'life-call '(:before) (list (find-class 'life-base)))))
;; Around can short-circuit, and changed arguments propagate through the core.
(defmethod life-short ((x integer)) :primary)
(defmethod life-short :around ((x integer)) (values :short (next-method-p)))
(print (multiple-value-list (life-short 1)))
(defmethod life-newargs ((x integer)) (life-log x) (values x (+ x 1)))
(defmethod life-newargs :before ((x integer)) (life-log (list :before x)))
(defmethod life-newargs :after ((x integer)) (life-log (list :after x)))
(defmethod life-newargs :around ((x integer)) (call-next-method (+ x 10)))
(let ((*life-log* nil)) (print (multiple-value-list (life-newargs 1))) (print (reverse *life-log*)))
;; Initialization hooks and method-defined initargs.
(defclass life-init () ((x :initarg :x :initform 2 :accessor life-init-x)
                        (unbound :accessor life-unbound)) (:default-initargs :x 5))
(defmethod initialize-instance :before ((x life-init) &key extra) (setf (slot-value x 'unbound) extra))
(defmethod initialize-instance :after ((x life-init) &key extra) (incf (life-init-x x) (or extra 0)))
(let ((x (make-instance 'life-init :extra 3)))
  (print (list (life-init-x x) (life-unbound x)))
  (reinitialize-instance x :x 20)
  (print (life-init-x x))
  (slot-makunbound x 'x)
  (shared-initialize x '(x))
  (print (life-init-x x)))
(print (handler-case (make-instance 'life-init :wrong t) (error () :bad-initarg)))
(let ((x (allocate-instance (find-class 'life-init))))
  (print (list (slot-boundp x 'x) (slot-boundp x 'unbound))))
;; Before initialization can bind a slot and suppress its initform.
(defvar *life-side* 0)
(defclass life-before () ((x :initform (incf *life-side*) :reader life-before-x)))
(defmethod initialize-instance :before ((x life-before) &key) (setf (slot-value x 'x) 9))
(print (list (life-before-x (make-instance 'life-before)) *life-side*))
;; Rack migration retains identity, common values and unbound slots.
(defclass life-change () ((x :initform 1 :accessor life-change-x) (drop :initform 7) unbound))
(defclass life-descendant (life-change) ((child :initform 8 :reader life-child-slot)))
(defparameter *life-old-class* (find-class 'life-change))
(defparameter *life-old* (make-instance 'life-descendant))
(setf (life-change-x *life-old*) 42)
(defvar *life-update* nil)
(defmethod update-instance-for-redefined-class :after ((x life-change) added discarded plist &key)
  (setf *life-update* (list (sort (remove 'unbound added) #'string<) (sort (copy-list discarded) #'string<) (getf plist 'drop))))
(defclass life-change () ((added :initform 99 :reader life-added) (x :initform 0 :accessor life-change-x) unbound))
(let ((saved *life-old*))
  (print (list (life-change-x saved) (life-added saved) (life-child-slot saved)
               (slot-boundp saved 'unbound) (eq saved *life-old*) (eq *life-old-class* (find-class 'life-change))))
  (print *life-update*))
;; Old generated accessors disappear; more specific user methods survive.
(defclass life-access () ((x :initform 3 :reader life-old-reader)))
(defclass life-access () ((y :initform 4 :reader life-new-reader)))
(print (handler-case (life-old-reader (make-instance 'life-access)) (error () :old-reader-removed)))
(defclass life-external () ((x :initform 3 :reader life-external-reader)))
(defclass life-external-child (life-external) ())
(defmethod life-external-reader ((x life-external-child)) :external)
(defclass life-external () ())
(print (life-external-reader (make-instance 'life-external-child)))
;; Shared-to-local and local-to-shared transitions.
(defclass life-allocation () ((a :allocation :class :initform 4) (b :initform 8)))
(defparameter *life-allocation* (make-instance 'life-allocation))
(setf (slot-value *life-allocation* 'a) 12)
(defclass life-allocation () ((a :initform 99) (b :allocation :class :initform 20)))
(print (list (slot-value *life-allocation* 'a) (slot-value *life-allocation* 'b)))
;; Changing superclasses changes applicability and inherited layout.
(defclass life-left () ((left :initform 10)))
(defclass life-right () ((right :initform 20)))
(defclass life-switch (life-left) ())
(defparameter *life-switch* (make-instance 'life-switch))
(defmethod life-dispatch ((x life-left)) :left)
(defmethod life-dispatch ((x life-right)) :right)
(print (life-dispatch *life-switch*))
(defclass life-switch (life-right) ())
(print (list (life-dispatch *life-switch*) (typep *life-switch* 'life-left)
             (slot-value *life-switch* 'right)))
;; Forward references finalize transitively without replacing class objects.
(defclass life-forward-child (life-forward-parent) ((child :initform 3)))
(defparameter *life-forward-class* (find-class 'life-forward-parent))
(print (handler-case (make-instance 'life-forward-child) (error () :unfinalized)))
(defclass life-forward-parent () ((parent :initform 4)))
(print (list (eq *life-forward-class* (find-class 'life-forward-parent))
             (slot-value (make-instance 'life-forward-child) 'parent)))
;; Name registration is independent of class and method identity.
(setf (find-class 'life-alias) (find-class 'life-forward-parent))
(defparameter *life-alias-class* (find-class 'life-alias))
(defparameter *life-alias-instance* (make-instance 'life-alias))
(setf (find-class 'life-forward-parent) nil)
(print (list (find-class 'life-forward-parent nil) (eq (class-of *life-alias-instance*) *life-alias-class*)
             (typep *life-alias-instance* 'life-alias) (typep (make-instance 'life-forward-child) *life-alias-class*)))
(defclass life-alias-child (life-alias) ())
(print (slot-value (make-instance 'life-alias-child) 'parent))
;; change-class preserves identity and supplies a previous-instance snapshot.
(defclass life-different () ((x :initarg :x :initform 0 :accessor life-different-x) (new :initform 30)))
(defvar *life-previous* nil)
(defmethod update-instance-for-different-class :before ((old life-base) (new life-different) &key)
  (setf *life-previous* (list (class-name (class-of old)) (slot-value old 'x))))
(let* ((x (make-instance 'life-base :x 17)) (saved x))
  (change-class x 'life-different)
  (print (list (eq x saved) (life-different-x x) (slot-value x 'new) *life-previous*)))
;; An explicit obsolescence cycle keeps the current slot values.
(print (progn (make-instances-obsolete 'life-different) :obsolete))
(print (life-different-x (make-instance 'life-different :x 22)))
