;; Phase 26：defstruct の、Codex のレビューで見つけた例（構築子・:include・オプション・pretty でない印字。詳細設計 §10.5）。
;; 期待値は SBCL 2.6.7 と同じ出力。defstruct.lisp から分けた（GC stress とネイティブの実行に時間がかかるため）

(defmacro try (form)
  `(handler-case (print (multiple-value-list ,form))
     (type-error (c) (format t "~%TYPE-ERROR ~S ~S" (type-error-datum c) (type-error-expected-type c)))
     (error () (format t "~%ERR"))))
(defmacro te (form) `(handler-case ,form (type-error () :type-error)))
;; :include の例が使う構造体（コンパイル時にも見えるようにトップレベルで定義する）
(defstruct (pf (:print-function (lambda (o s d) (format s "#<pf ~A depth ~A>" (pf-a o) d)))) a)
;; #2：BOA の supplied-p の変数と同じ名前のスロット
(try (defstruct (sup (:constructor sup-boa (&optional (a 10 present))) (:constructor sup-key (&key (a 10 present)))) a (present :default)))
(try (list (sup-present (sup-boa)) (sup-present (sup-boa 3)) (sup-present (sup-key)) (sup-present (sup-key :a 3))))
;; #3：:include でスロットの型を書き換えても、元の型は満たさなければならない
(defstruct orig (x 1 :type integer))
(try (defstruct (child (:include orig (x 2 :type t)))))
(try (defstruct (child2 (:include orig (x 2 :type fixnum)))))
(try (te (child-x (make-child :x "bad"))))
(try (te (child2-x (make-child2 :x "bad"))))
(try (te (child2-x (make-child2 :x (expt 10 30)))))
(try (te (let ((c (make-child))) (setf (child-x c) "bad"))))
(try (te (let ((c (make-child))) (setf (orig-x c) "bad"))))
(try (list (child-x (make-child)) (child2-x (make-child2 :x 7))))
;; 2回目 #2：:include の (x) は元の初期値のまま、(x nil) は NIL
(defstruct base (x 42) (y 7 :type integer))
(try (defstruct (sub (:include base (x)))))
(try (defstruct (sub2 (:include base (x nil)))))
(try (defstruct (sub4 (:include base (y)))))
(try (list (sub-x (make-sub)) (sub2-x (make-sub2)) (sub4-y (make-sub4))))
;; 2回目 #3：pretty でない印字でも、構造体の中のリストに深さと共有の印が伝わる
(defstruct foo x y)
(try (let ((*print-pretty* nil) (*print-level* 1)) (prin1-to-string (make-foo :x '(1 2)))))
(try (let ((*print-pretty* nil) (*print-level* 2)) (prin1-to-string (make-foo :x '(1 (2)) :y (vector 1 (vector 2))))))
(try (let ((*print-pretty* nil) (*print-circle* t) (l (list 1 2))) (prin1-to-string (make-foo :x l :y l))))
(try (let ((*print-pretty* nil) (*print-circle* t) (l (list 1 2))) (prin1-to-string (list l (make-foo :x l :y (vector l))))))
(try (let ((*print-pretty* nil) (*print-length* 1)) (prin1-to-string (list (make-foo :x '(1 2 3)) 2))))
(try (let ((*print-pretty* nil) (*print-level* 2) (*print-circle* t) (l (list 1 (list 2)))) (prin1-to-string (vector l (make-foo :x l)))))
(try (let ((*print-pretty* nil) (*print-level* 1)) (format nil "~S ~A" (make-foo :x '(1 2)) (make-foo :y "s"))))
(try (let ((*print-pretty* nil) (*print-circle* t) (l (list 1 2)))
       (equalp (read-from-string (prin1-to-string (make-foo :x l :y l))) (make-foo :x l :y l))))
;; 2回目 #4：(:conc-name "") は今のパッケージのシンボル、(:conc-name nil) はスロットのシンボル
(defpackage :p26-slots (:use :cl) (:export :cx :cz))
(eval (read-from-string "(defstruct (cn1 (:conc-name \"\")) (p26-slots:cx 1))"))
(eval (read-from-string "(defstruct (cn2 (:conc-name nil)) (p26-slots:cz 1))"))
(try (list (not (null (fboundp (find-symbol "CX" "COMMON-LISP-USER")))) (not (null (fboundp (find-symbol "CX" "P26-SLOTS"))))
           (not (null (fboundp (find-symbol "CZ" "COMMON-LISP-USER")))) (not (null (fboundp (find-symbol "CZ" "P26-SLOTS"))))))
;; 2回目 #5：(:print-function nil)・(:print-object nil) は #S(…) の形（引き継いだ印字の関数も外す）
(try (defstruct (pf1 (:print-function nil)) x))
(try (defstruct (po1 (:print-object nil)) x))
(try (defstruct (pc1 (:include pf) (:print-function nil)) y))
(try (defstruct (pc2 (:include pf) (:print-object nil)) y))
(try (list (prin1-to-string (make-pf1)) (prin1-to-string (make-po1)) (prin1-to-string (make-pc1)) (prin1-to-string (make-pc2))))
;; #5：オプションの余分な引数・型・重なり
(defmacro ex (form) `(handler-case (progn (macroexpand-1 ',form) :accepted) (error () :error)))
;; 3回目 #2：pretty でない印字で、構造体の中の多次元の文字の配列にも深さが伝わる
(defstruct box x)
(defun char-array () (make-array '(2 2) :element-type 'character :initial-element #\a))
(try (let ((*print-pretty* nil) (*print-level* 1)) (prin1-to-string (make-box :x (char-array)))))
(try (let ((*print-pretty* nil) (*print-level* 2)) (prin1-to-string (make-box :x (char-array)))))
(try (let ((*print-pretty* nil) (*print-level* 3)) (prin1-to-string (make-box :x (char-array)))))
(try (let ((*print-pretty* nil) (*print-level* 1)) (prin1-to-string (list (char-array)))))
(try (let ((*print-pretty* t) (*print-level* 1)) (prin1-to-string (make-box :x (char-array)))))
(try (let ((*print-pretty* t) (*print-level* 2)) (prin1-to-string (list (make-box :x (char-array))))))
(try (let ((*print-pretty* nil) (*print-level* 1)) (prin1-to-string (make-box :x (make-array '(2 2) :initial-element 1)))))
(try (let ((*print-pretty* nil) (*print-level* 1)) (prin1-to-string (make-box :x "str"))))
(try (let ((*print-pretty* nil) (*print-level* 2) (*print-length* 1)) (prin1-to-string (make-box :x (char-array)))))
(try (let ((*print-pretty* nil) (*print-level* 2)) (prin1-to-string (list (list (char-array)) (make-box :x (list (char-array)))))))
;; 2回目 #6：:include で同じスロットを 2 回は書き換えられない
(try (list (ex (defstruct (dup (:include base (x 1) (x 2))))) (ex (defstruct (dup (:include base (x 1) (y 2)))))))
(try (list (ex (defstruct (bad (:copier nil extra)) a)) (ex (defstruct (bad (:predicate p extra)) a))
           (ex (defstruct (bad (:conc-name a b)) a)) (ex (defstruct (bad (:constructor m (a) extra)) a))
           (ex (defstruct (bad (:print-function f g)) a)) (ex (defstruct (bad (:print-object f g)) a))))
(try (list (ex (defstruct (bad (:copier 5)) a)) (ex (defstruct (bad (:predicate "p")) a)) (ex (defstruct (bad (:conc-name 5)) a))))
(try (list (ex (defstruct (bad :copier :copier) a)) (ex (defstruct (bad (:conc-name x-) (:conc-name y-)) a))
           (ex (defstruct (bad (:copier c1) (:copier c2)) a)) (ex (defstruct (bad (:predicate c1) (:predicate c2)) a))
           (ex (defstruct (bad :include) a)) (ex (defstruct (bad (:constructor) (:constructor)) a))))
