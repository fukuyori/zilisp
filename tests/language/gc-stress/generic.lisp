;; P28 primary method dispatch; SBCL 2.6.10.168.
(defclass g-base () ((name :initarg :name :accessor g-name)))
(defclass g-child (g-base) ((extra :initform 8 :reader g-extra :writer g-put)))
(defclass g-other () ((name :initarg :name :accessor g-name)))
(let ((a (make-instance 'g-child :name "a")) (b (make-instance 'g-other :name "b")))
  (print (list (g-name a) (g-name b) (g-extra a) (typep #'g-name 'generic-function)))
  (setf (g-name a) "c") (g-put 9 a)
  (print (list (g-name a) (g-extra a))))
(defgeneric g-talk (x))
(defmethod g-talk ((x t)) (list :t (next-method-p)))
(defmethod g-talk ((x g-base)) (cons :base (call-next-method)))
(defmethod g-talk ((x g-child)) (cons :child (call-next-method)))
(print (g-talk (make-instance 'g-child :name "n")))
(print (list (typep #'g-talk 'function) (typep #'g-talk 'standard-object)
             (eq (class-of #'g-talk) (find-class 'standard-generic-function))))
(defgeneric g-pair (x y) (:argument-precedence-order y x))
(defmethod g-pair ((x integer) (y t)) :x)
(defmethod g-pair ((x t) (y integer)) :y)
(print (list (g-pair 1 2) (g-pair 1 "s")))
(defgeneric g-eql (x))
(defmethod g-eql ((x integer)) :integer)
(defmethod g-eql ((x (eql 2))) :two)
(print (list (g-eql 2) (g-eql 3) (g-eql 2) (g-eql 4)))
;; Cache invalidation for replacement, insertion and removal.
(defmethod g-eql ((x integer)) :new)
(print (g-eql 3))
(let* ((gf #'g-eql) (m (find-method gf nil (list (find-class 'integer)))))
  (print (list (typep m 'method) (typep m 'standard-method) (method-qualifiers m)
               (length (compute-applicable-methods gf '(2)))))
  (remove-method gf m)
  (print (handler-case (g-eql 3) (error () :no-method)))
  (add-method gf m)
  (print (g-eql 3)))
(defgeneric g-values (x))
(defmethod g-values ((x t)) (values x 2 3))
(defmethod g-values ((x integer)) (call-next-method (+ x 10)))
(print (multiple-value-list (g-values 1)))
(defgeneric g-none (x))
(defmethod g-none ((x integer)) (call-next-method))
(print (handler-case (g-none 1) (error () :no-next)))
(defgeneric g-key (x &key a))
(defmethod g-key ((x t) &key a) (list :base a))
(defmethod g-key ((x integer) &key a b) (list a b (call-next-method)))
(print (g-key 1 :a 2 :b 3))
(print (handler-case (g-key 1 :bad 2) (error () :bad-key)))
(defgeneric g-rest (x &rest args))
(defmethod g-rest ((x integer) &key a) a)
(print (g-rest 1 :a nil))
(defgeneric g-rest-key (x &key a))
(defmethod g-rest-key ((x integer) &rest args) args)
(print (handler-case (g-rest-key 1 :bad 2) (error () :bad-key)))
(defgeneric g-opt (x &optional y))
(defmethod g-opt ((x integer) &optional (y 9)) (list x y))
(print (list (g-opt 1) (g-opt 1 2)))
;; The implicit method block supports RETURN-FROM.
(defmethod g-return ((x integer)) (return-from g-return :returned) :bad)
(print (g-return 1))
(defmethod print-object ((x g-base) stream)
  (print-unreadable-object (x stream :type t) (write-string (g-name x) stream)))
(print (list (write-to-string (make-instance 'g-base :name "named"))
             (let ((*print-pretty* nil)) (write-to-string (list (make-instance 'g-base :name "nested"))))))
;; EQL must distinguish distinct strings having equal contents.
(defparameter *g-string* (copy-seq "same"))
(defmethod g-string ((x t)) :other)
(defmethod g-string ((x (eql *g-string*))) :special)
(print (list (g-string *g-string*) (g-string (copy-seq "same")) (g-string *g-string*)))
;; Accessor caches retain lexical state and distinguish inherited layouts.
(defclass g-left () ((pad :initform 7)))
(defclass g-mixed (g-left g-base) ())
(defclass g-shared () ((value :allocation :class :initform 1 :accessor g-shared-value)))
(let ((base (make-instance 'g-base :name "base"))
      (mixed (make-instance 'g-mixed :name "mixed"))
      (s1 (make-instance 'g-shared)) (s2 (make-instance 'g-shared)))
  (setf (g-shared-value s1) 42)
  (print (list (g-name base) (g-name mixed) (g-name base) (g-shared-value s2)))
  (slot-makunbound mixed 'name)
  (print (handler-case (g-name mixed) (unbound-slot () :unbound))))
;; Method closures survive allocations after their defining scope exits.
(let ((captured (list :captured))) (defmethod g-captured ((x integer)) captured))
(dotimes (i 200) (make-list 30 :initial-element i))
(print (g-captured 1))
;; Distinct built-in, condition, structure and metaobject dispatch classes.
(defstruct g-struct value)
(defmethod g-kind ((x t)) :other)
(defmethod g-kind ((x condition)) :condition)
(defmethod g-kind ((x structure-object)) :structure)
(defmethod g-kind ((x class)) :class)
(defmethod g-kind ((x method)) :method)
(defmethod g-kind ((x generic-function)) :generic)
(defmethod g-kind ((x vector)) :vector)
(defmethod g-kind ((x string)) :string)
(print (mapcar #'g-kind (list (make-condition 'simple-error) (make-g-struct)
                              (find-class 'g-base) (find-method #'g-kind nil (list (find-class t)))
                              #'g-kind #(1) "s" 1 #(2) "t")))
;; A DEFSTRUCT printer takes precedence over STRUCTURE-OBJECT methods.
(defmethod print-object ((x structure-object) stream) (write-string "structure" stream))
(defstruct (g-printed (:print-function (lambda (x s depth) (declare (ignore x depth)) (write-string "custom" s)))))
(print (list (write-to-string (make-g-printed)) (write-to-string (make-g-struct))))
;; Rejected redeclarations leave the existing dispatch order intact.
(print (handler-case (eval '(defgeneric g-pair (x y) (:argument-precedence-order x x)))
         (error () :invalid-order)))
(print (g-pair 1 2))
(print (handler-case (eval '(defmethod g-pair ((x integer)))) (error () :incongruent)))
