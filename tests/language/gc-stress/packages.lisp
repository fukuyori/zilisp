;; shadow・shadowing-import・import・unintern
(make-package "P3" :use nil)
(intern "FOO" "P3")
(print (shadow "FOO" "P3"))
(print (use-package "P1" "P3"))
(print (names (package-shadowing-symbols "P3")))
(print (multiple-value-list (find-symbol "FOO" "P3")))
(make-package "P4" :use '("P1"))
(print (shadowing-import (find-symbol "FOO" "P3") "P4"))
(print (eq (find-symbol "FOO" "P4") (find-symbol "FOO" "P3")))
(print (unintern (find-symbol "FOO" "P4") "P4"))
(print (multiple-value-list (find-symbol "FOO" "P4")))
(print (multiple-value-list (import 'cl:car "P3")))
(print (multiple-value-list (find-symbol "CAR" "P3")))
(print (unintern 'cl:car "P3"))
(print (symbol-package 'cl:car))
(let ((s (intern "HOME" "P3"))) (unintern s "P3") (print (list (symbol-package s) (format nil "~s" s))))

;; unexport・unuse-package・rename-package・delete-package
(print (unexport (find-symbol "FOO" "P1") "P1"))
(print (multiple-value-list (find-symbol "FOO" "P1")))
(print (multiple-value-list (find-symbol "FOO" "P2")))
