;; defpackage
;; defpackage はトップレベルに書く（ファイル全体を先にコンパイルするとき、後のフォームを読む前にパッケージができる）
(defpackage :d1 (:nicknames :d1n) (:use :cl) (:export :a :b) (:shadow :list) (:intern :c))
(print (package-name (find-package :d1)))
(print (list (package-nicknames :d1) (names (package-use-list :d1))
             (multiple-value-list (find-symbol "A" :d1)) (multiple-value-list (find-symbol "C" :d1))
             (multiple-value-list (find-symbol "LIST" :d1)) (multiple-value-list (find-symbol "CAR" :d1))))
(defpackage :d2 (:use :cl) (:import-from :d1 :c :a) (:shadowing-import-from :d1 :list))
(print (package-name (find-package :d2)))
(print (list (find-symbol "C" :d2) (find-symbol "LIST" :d2) (find-symbol "A" :d2)))
(defpackage "d7" (:use "COMMON-LISP"))
(print (package-name (find-package "d7")))
(print (package-name (find-package "d7")))
(defpackage :d8 (:use :cl) (:local-nicknames (:l :d1)))
(print (package-name (find-package :d8)))
(print (let ((*package* (find-package :d8))) (list (eq (find-package "L") (find-package :d1)) (format nil "~s" 'd1:a))))
(print (find-package "L"))
(print (package-use-list (defpackage :d9)))

;; in-package と、パッケージ修飾の読み取り
(defpackage :my-lib (:use :cl) (:export :public-fn))
(in-package :my-lib)
(defun public-fn () (private-fn))
(defun private-fn () :secret)
(defvar *counter* 0)
(print (package-name *package*))
(in-package :cl-user)
(print (list (my-lib:public-fn) (my-lib::private-fn) my-lib::*counter* (package-name *package*)))
(print (list (format nil "~s" 'my-lib:public-fn) (format nil "~s" 'my-lib::private-fn)))
;; use-package も、後のフォームの読み方を変えるので eval-when で囲む（compile-file の書き方）
(eval-when (:compile-toplevel :load-toplevel :execute) (use-package :my-lib))
(print (list (public-fn) (multiple-value-list (find-symbol "PUBLIC-FN"))))

;; 教材（Level 15）の形：複数のパッケージ
(defpackage :my-project.utils (:use :cl) (:export :split-string))
(defpackage :my-project.core (:use :cl :my-project.utils) (:export :process-data))
(defpackage :my-project (:use :cl :my-project.core) (:export :main))
(in-package :my-project.utils)
(defun split-string (s) (let ((r nil) (start 0)) (dotimes (i (length s)) (when (char= (char s i) #\,) (push (subseq s start i) r) (setq start (1+ i)))) (nreverse (cons (subseq s start) r))))
(in-package :my-project.core)
(defun process-data (s) (mapcar #'length (split-string s)))
(in-package :my-project)
(defun main () (process-data "ab,c,def"))
(in-package :cl-user)
(print (my-project:main))
(print (list (multiple-value-list (find-symbol "SPLIT-STRING" :my-project.core)) (multiple-value-list (find-symbol "SPLIT-STRING" :my-project))))

;; Codex のレビュー P22 の指摘
;; #1：ネイティブでも、defpackage・make-package の前にはパッケージがない（起動時に定数を読むときに一覧に登録しない）
(print (find-package "NP0"))
(defpackage :np0)
(print 'np0::x)
(eval-when (:compile-toplevel :load-toplevel :execute) (make-package "NQ0"))
(print (list (package-name (find-package "NQ0")) 'nq0::y))
;; #2：ホームのないシンボルを、既にあるパッケージに import し直すと、ホームが設定される
(let ((p (make-package "RP")) (q (make-package "RQ")))
  (let ((s (intern "X" p)))
    (import s q) (unintern s p) (import s q)
    (print (eq (symbol-package s) q))))
;; #3：shadowing-import はホームを変えない
(let ((p (make-package "RS")) (s (make-symbol "X")))
  (shadowing-import s p)
  (print (list (symbol-package s) (eq (find-symbol "X" p) s))))
