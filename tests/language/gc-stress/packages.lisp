;; パッケージ（Phase 22）：パッケージの関数・defpackage・in-package・名前の解決。期待値は SBCL 2.6.7 と同じ出力
(setq *print-pretty* nil)
(defun names (l) (sort (mapcar (lambda (x) (if (packagep x) (package-name x) (string x))) l) #'string<))

;; 今のパッケージ
(print (list (package-name *package*) (packagep *package*) (packagep 'x)))
