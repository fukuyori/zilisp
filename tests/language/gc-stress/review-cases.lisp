;; 0.3 のレビュー（agy・Codex）で直したもの：エラーにならない場合。期待値は SBCL 2.6.7 と同じ出力（大きな列の場合は eval_test.zig）
;; （エラーの種類は src/compiler/eval_test.zig の単体テスト）。作るファイルは .zig-cache/lang-tmp/ の下
(defvar *dir* ".zig-cache/lang-tmp/review-cases/")
(ensure-directories-exist *dir*)
(defun f (name) (concatenate 'string *dir* name))

;; loop：with の分解と and、for の部分節の順、by を一度だけ評価、it
(print (loop with (a b) = '(1 2) return (+ a b)))
(print (loop with nil = '(1 2) return 42))
(print (let ((a 10)) (loop with a = 1 and b = a return (list a b))))
(print (loop with (a (b . c)) = '(1 (2 . 3)) and d = 4 return (list a b c d)))
(print (loop for x in '(a b) for i from 1 to 3 collect (list x i) finally (return i)))
(print (with-output-to-string (*standard-output*) (loop for i by (progn (princ 1) 2) to (progn (princ 2) 5) from (progn (princ 3) 0) collect i)))
(print (loop for i from 10 downto 1 by 3 collect i))
(print (loop for i below 3 for j upfrom 5 collect (list i j)))
(print (let ((n 0)) (loop for x in '(a b c) by (progn (incf n) #'cdr) collect x) n))
(print (let ((n 0)) (list (loop for x on '(a b c d) by (progn (incf n) #'cddr) collect x) n)))
(print (loop for x in '(1 nil 3) when x collect it))
(print (loop for x in '(1 2 3 4) when (evenp x) collect it and count t into n finally (return n)))
(print (loop for x in '(1 2 3) sum x into s count x into c finally (return (list s c))))
(print (loop for x in '(3 1 2) maximize x into hi minimize x into lo finally (return (list hi lo))))
(print (let ((h (make-hash-table))) (setf (gethash 1 h) 2) (loop for k being the hash-keys of h using (hash-value v) collect (list k v))))
;; mapcan・reduce・do・butlast
(print (mapcan (lambda (x) (if (evenp x) (list x x) nil)) '(1 2 3 4)))
(print (list (reduce #'+ '(1 2 3 4) :start 1 :end 3) (reduce #'+ #(1 2 3 4) :start 2) (reduce #'list '(1 2 3) :from-end t)))
(print (do ((x 1 (1+ x)) (y)) ((> x 2) (list x y))))
(print (list (butlast '(a b . c) 0) (butlast '(a b c) 1) (nbutlast (list 1 2 3) 0) (butlast '(1 2) 5)))
;; expt
(print (list (expt -2 2.0) (expt -2 3.0) (expt -2.5d0 2.0) (expt 1 (expt 2 100)) (expt -1 (1+ (expt 2 100)))))
;; 列と配列
(print (= (sxhash (make-symbol "X")) (sxhash (make-symbol "X"))))
(print (= (sxhash (list 'a "b" 1)) (sxhash (list 'a "b" 1))))
(print (list (remove-duplicates '(1 2 3) :test #'< :from-end t) (remove-duplicates '(1 2 1 3 2) :from-end t)))
(print (let ((v (vector 1 2))) (eq v (coerce v '(vector t)))))
(print (let ((v (make-array '(2 2)))) (eq v (coerce v '(array t (2 2))))))
(print (let ((s "abc")) (list (eq s (coerce s '(simple-array character (3)))) (eq s (coerce s '(vector t))))))
(print (funcall (coerce '(lambda (x) (+ x 1)) 'function) 4))
(print (make-array 3 :initial-contents '(a b c)))
(print (let ((v (make-array 2 :fill-pointer 2 :adjustable t :initial-contents '(1 2)))) (adjust-array v 4 :fill-pointer 3) (list (fill-pointer v) (length v))))
;; ストリーム
(print (let ((s (make-string-input-stream "あ b"))) (list (char-code (read-char s)) (peek-char t s) (unread-char #\Space s) (read-char s))))
(print (streamp (make-synonym-stream nil)))
(print (let ((s (make-string-output-stream))) (list (streamp (make-broadcast-stream s)) (streamp (make-two-way-stream (make-string-input-stream "x") s)))))
(print (write-sequence #(65 66) (make-broadcast-stream)))
(print (with-open-file (s (f "bin.dat") :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
         (write-sequence #(65 66 67) (make-broadcast-stream s))))
(print (with-open-file (s (f "bin.dat") :element-type '(unsigned-byte 8)) (list (read-byte s) (read-byte s) (read-byte s))))
(print (with-open-file (s (f "bin.dat") :direction :probe) (list (input-stream-p s) (output-stream-p s) (open-stream-p s))))
;; load は *readtable* を束縛する
(with-open-file (o (f "sub-rt.lisp") :direction :output :if-exists :supersede)
  (write-string "(setq *readtable* (copy-readtable nil)) (setf (readtable-case *readtable*) :downcase)" o))
(print (let ((orig *readtable*)) (load (f "sub-rt.lisp")) (list (eq *readtable* orig) (readtable-case *readtable*))))
;; equal とパス名
(print (equal (cons 1 (pathname "a")) (cons 1 (pathname "a"))))
(print (let ((ht (make-hash-table :test #'equal))) (setf (gethash (cons 1 (pathname "a")) ht) :found) (gethash (cons 1 (pathname "a")) ht)))
;; キーワードの unintern
(print (let ((s (intern "TEMP-KW-UNINTERN" :keyword))) (unintern s :keyword) (makunbound s) (set s 42) (list (keywordp s) (symbol-value s) (progv (list s) '(99) (symbol-value s)))))
;; パス名
(print (let ((s (make-array 3 :element-type 'character :adjustable t :initial-contents "foo"))) (list (namestring (make-pathname :name s)) (namestring (make-pathname :directory s)))))
(print (list (pathname-directory (make-pathname :directory '(:relative "a" :back "b"))) (pathname-directory (merge-pathnames (make-pathname :directory '(:relative "a" :back "b")) (make-pathname :directory nil)))))
(print (list (pathname-match-p "foo.txt" "**/*.txt") (pathname-match-p "a/foo.txt" "**/*.txt")))
(print (multiple-value-list (parse-namestring #P"foo.txt" nil *default-pathname-defaults* :start 2)))
(defvar *fs*)
(print (with-open-file (*fs* (f "tmp.txt") :direction :output :if-exists :supersede) (pathname-name (pathname (make-synonym-stream '*fs*)))))
;; パッケージの別名
(print (package-nicknames (make-package "REVIEW-PKG-1" :nicknames '("REVIEW-PKG-1"))))
(print (package-nicknames (make-package "REVIEW-PKG-2" :nicknames '("RNK1" "RNK1"))))
;; Reader：読み飛ばしと reader macro、backquote の中の recursive な read、NIL の印字、pprint-dispatch
(defvar *hit* nil)
(let ((*readtable* (copy-readtable nil)))
  (set-macro-character #\! (lambda (s c) (declare (ignore c)) (read s t nil t)))
  (print (read-from-string "(#+no-such !#.(setq *hit* t) good)"))
  (print (read-from-string "`(!,x)")))
(print *hit*)
(let ((*readtable* (copy-readtable nil)))
  (set-macro-character #\! (lambda (s c) (declare (ignore s c)) 42))
  (print (list (read-from-string "!") (let ((*read-suppress* t)) (read-from-string "!")))))
(print (let ((*readtable* (copy-readtable nil))) (setf (readtable-case *readtable*) :downcase) (let ((s (write-to-string nil))) (list s (null (read-from-string s))))))
(let ((*print-pprint-dispatch* (copy-pprint-dispatch nil)))
  (set-pprint-dispatch 'integer nil)
  (print '(quote x))
  (print '(let ((a 1) (b 2)) (list a b))))
(print (read-delimited-list #\] (make-string-input-stream "a b ]")))
;; 定数の中で共有する uninterned なシンボル（ネイティブでも同じ）
(print (let ((x '(#1=#:g))) (eq (car x) '#1#)))
(terpri)
